@page
@model Integral.Web.PortalSite.Pages_Albert.OrganisationPeople
@{ Layout = "_Layout_AdminLTE"; }

@section HeadContent {
  <link rel="stylesheet" type="text/css" href="@(PathHelper.UrlPath.CSS)survey-viewer-common.css" />
}

<div class="content-action-bar">
  <div class="left">
    <div class="status-toggle input-group" id="btnGrpActive" data-toggle="buttons">
      <label class="btn @(Model.searchInfo.StatusInactive ? "" : "active")"><input type="radio" name="toggleActive" value="@PathHelper.AbleUrlValues.OrganisationPeople_Active" @(Model.searchInfo.StatusInactive ? "" : "checked") />Active</label>
      <label class="btn @(Model.searchInfo.StatusInactive ? "active" : "")"><input type="radio" name="toggleActive" value="@PathHelper.AbleUrlValues.OrganisationPeople_Inactive" @(Model.searchInfo.StatusInactive ? "checked" : "") />Completed</label>
    </div>
    <div class="search-input">
      <i class="fa fa-search"></i>
      <input type="text" id="txtSearch" name="@PathHelper.AbleUrlKeys.OrgPeopleSearchTerm" value="" placeholder="Name, Email, Program..." autofocus="autofocus">
    </div>
  </div>
  <div class="right">
    @if (Model.CanAddCompanyParticipants) {
      @Html.Raw(WebHelper.GetAddParticipantDropdownButton(WebHelper.AddParticipantFrom.Company, Model.CompanyInfo.CompanyId))
    }
  </div>
</div>

<input type="hidden" id="inpGetPage" value="1" />

<div class="table-responsive">
  <table class="table table-bordered table-hover table-rowlink limit-width" @Html.Raw(Model.CanViewPeopleDetails ? $"data-rowlink-url=\"{Model.GetRowLinkUrl()}\"" : "")>
    <thead>
      <tr>
        <th class="type-fullname">Name</th>
        <th class="type-status">Info</th>
        <th class="type-progress-lg">Sessions</th>
        <th class="type-progress-lg">Workshops</th>
        <th class="type-date">Latest 360</th>
        <th class="type-date-range">Latest Eval</th>
      </tr>
      <tr class="displaynone rowData" id="rowTemplate" data-rowlink-id="" tabindex="0">
        <td class="rowDataCell type-fullname" data-fieldname="NameDisplay"></td>
        <td class="rowDataCell type-status" data-fieldname="UserActivityInfo"></td>
        <td class="rowDataCell type-progress-lg" data-fieldname="CoachingSessionsProgressBar"></td>
        <td class="rowDataCell type-progress-lg" data-fieldname="WorkshopsProgressBar"></td>
        <td class="rowDataCell type-date" data-fieldname="Latest360Completed"></td>
        <td class="rowDataCell type-date-range" data-fieldname="LatestEvalCompleted"></td>
      </tr>
    </thead>
    <tbody id="tblPeopleBody">
    </tbody>
  </table>
</div>

<div class="table-bottom mb30">
  <div class="left">
    <span class="badge found-badge"><span class="pagination-total"></span>&nbsp; results</span>
  </div>
  <div class="right">
    <div class="pagination">
      <div class="pagination-page">Page: <div class="pagination-pagebuttons"><div class="pagination-pagebutton">1</div></div></div>
    </div>
  </div>
</div>

@section PostScriptContent {

  <script>
    (function ($) {
      var inpGetPage;
      var rowTemplate, tblPeopleBody, txtSearch;
      var paginationPageButtons, paginationPageButton, btnGrpActive, paginationSection;
      var keyTimeout = null;
      var currentSearchValue, currentActiveToggleValue, currentPage;

      $(document).ready(function () {

        currentSearchValue = "";
        currentActiveToggleValue = "";
        currentPage = 0;

        btnGrpActive = $("#btnGrpActive");
        txtSearch = $("#txtSearch");
        inpGetPage = $("#inpGetPage");
        paginationSection = $(".pagination");
        paginationPageButtons = $(".pagination-pagebuttons");
        paginationPageButton = $(".pagination-pagebutton");
        paginationPageButton.detach();
        rowTemplate = $("#rowTemplate");
        rowTemplate.detach().removeAttr("id").removeClass("displaynone");
        tblPeopleBody = $("#tblPeopleBody");

        SetActiveToggleValue(@Html.Raw(SessionHelper.AppState.OrganisationPeople.Search_StatusInactive.ToJSTrueFalse()));
        txtSearch.val("@SessionHelper.AppState.OrganisationPeople.Search_SearchTerm");
        inpGetPage.val("@SessionHelper.AppState.OrganisationPeople.Search_CurrentPage");

        btnGrpActive.on("change", "input:checked", ActiveToggled);
        txtSearch.keyup(SearchKeyUp);
        paginationPageButtons.click(GoToResultsPage);

        SearchKeyTimeout(txtSearch, true); // Get initial results.

      }); // ready

      function GetActiveToggleValue() {
        $checked = btnGrpActive.find("input:checked");
        if ($checked.length != 1) return "";
        return $checked.val();
      }

      function SetActiveToggleValue(StatusEndProgram) {
        var btn;
        if (StatusEndProgram === false) {
          btn = btnGrpActive.find('input[value="@PathHelper.AbleUrlValues.OrganisationPeople_Active"]');
        } else {
          btn = btnGrpActive.find('input[value="@PathHelper.AbleUrlValues.OrganisationPeople_Inactive"]');
        }
        if (btn.length === 1) {
          btn.prop("checked", true);
          btn.trigger("click");
        }
      }

      function ActiveToggled(evt) {
        SearchKeyTimeout(txtSearch, true);
      }

      function GoToResultsPage(ev) {
        var $btn = $(ev.target);
        if (!$btn.hasClass("pagination-pagebutton")) return;
        var page = $btn.text();
        inpGetPage.val(page);
        SearchKeyTimeout(txtSearch, true);
      }

      function SearchKeyUp(ev, data) {
        var isImmediate = (data && data.immediate);
        var $inp = $(ev.target);
        if (keyTimeout) clearTimeout(keyTimeout);
        if (isImmediate) SearchKeyTimeout($inp, isImmediate);
        else keyTimeout = setTimeout(function () { keyTimeout = null; SearchKeyTimeout($inp, isImmediate); }, 800);
      }

      function SearchKeyTimeout($inp, isImmediate) {

        var newSearchValue = "" + $inp.val();
        var newActiveToggleValue = GetActiveToggleValue();
        var newPage = parseInt(inpGetPage.val(), 10);
        var minLength = @Integral.Web.PortalSite.Pages_Albert.OrganisationPeople.Min_Search_Length;
        if (isNaN(newPage)) newPage = 1;

        if (newSearchValue === currentSearchValue
          && newActiveToggleValue === currentActiveToggleValue
          && newPage === currentPage
          && isImmediate !== true) return;

        if (newSearchValue.length > 0 && newSearchValue.length < minLength) {
          return;
        }

        if (newSearchValue !== currentSearchValue
          || newActiveToggleValue !== currentActiveToggleValue) newPage = 1; // new search, default to page 1

        currentSearchValue = newSearchValue;
        currentActiveToggleValue = newActiveToggleValue;
        currentPage = newPage;

        tblPeopleBody.empty();
        $.busyLoadFull("show");

        $.get(location.pathname,
          {
            "@PathHelper.AbleUrlKeys.OrgPeopleSearchTerm": encodeURIComponent(newSearchValue),
            "@PathHelper.AbleUrlKeys.OrgPeopleStatusToggle": encodeURIComponent(GetActiveToggleValue()),
            "@PathHelper.AbleUrlKeys.GetPage": newPage,
            "@PathHelper.AbleUrlKeys.CompanyId": encodeURIComponent(@WebHelper.GetQueryStringValue(PathHelper.AbleUrlKeys.CompanyId)),
            "@Integral.Web.PortalSite.Pages_Albert.OrganisationPeople.UrlParam_GetRows": true
          },
          function (data, status, jqXHR) { PopulateTableBody(data); },
          "json")
          .fail(function () { alert("Oops, there was a problem!"); })
          .always(function () { $.busyLoadFull("hide"); });
      }

      function PopulateTableBody(json) {

        tblPeopleBody.empty();

        if (!json) {
          tblPeopleBody.append($("<tr>").append($("<td>").attr("colspan", 6).text("No results found.")));
          paginationSection.hide();
          return;
        } else {
          paginationSection.show();
        }


        var rowsPerPage = json.RowsPerPage;
        var currentPage = json.CurrentPage;

        $(".pagination-total").text("");
        paginationPageButtons.empty();

        var results = json.results;
        if (!results) return;

        var totalRows = results.TotalRows;
        $(".pagination-total").text(totalRows);

        var totalPages = Math.ceil(totalRows / rowsPerPage);

        if (rowsPerPage != null) {
          for (var page = 1; page <= totalPages; page++) {
            var newButton = paginationPageButton.clone();
            newButton.text(page);
            if (page == currentPage) newButton.addClass("current");
            paginationPageButtons.append(newButton);
          }
        }

        // Hide Pagination section if there's no results to prevent showing 'Page' text.
        if (totalRows == 0) {
          paginationSection.hide();
        } else {
          paginationSection.show();
        }

        var rowList = results.OrgUsersInfoList;
        if (!rowList) return;
        for (var rowNum in rowList) {
          var thisUser = rowList[rowNum];

          var row = $("<tr>");
          var newRowHtml = row.prop('outerHTML').replace('<tr', `<tr ${thisUser.CoacheeRowAttribute}`);
          row = $(newRowHtml);

          var nameDisplay = $("<td>").html(thisUser.NameDisplay).addClass("type-fullname");
          var userActivityInfo = $("<td>").html(thisUser.UserActivityInfo).addClass("type-status");

          var coachingProgressBar = $("<td>").html(thisUser.CoachingSessionsProgressBar).addClass("type-progress-lg");
          var workshopProgressBar = $("<td>").html(thisUser.WorkshopsProgressBar).addClass("type-progress-lg");
          var latest360Completed = $("<td>").text(thisUser.Latest360Completed).addClass("type-date");
          var latestEvalCompleted = $("<td>").text(thisUser.LatestEvalCompleted).addClass("type-date");

          row.append(nameDisplay, userActivityInfo, coachingProgressBar, workshopProgressBar, latest360Completed, latestEvalCompleted);

          tblPeopleBody.append(row);
        }
        common_UpdateUI(tblPeopleBody);
      }

    })(jQuery);
  </script>

}
