@page
@model Integral.Web.PortalSite.Pages_Albert.QuoteQwilrView
@{ Layout = "_Layout_Public"; }

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

<div class="heading">
  <h2>@Model.QuoteInfo.QuoteTitle.HTMLEncode()</h2>
  <p>@Html.Raw(WebHelper.GetLink(new WebHelper.LinkInfo(PathHelper.Pages.QuotePublicPDF(Model.QuoteInfo.PublicGuid), "Download PDF", true) { ClickDisableSeconds = 10, ClickSpinnerSeconds = 10 }))</p>
</div>

<form method="post" action="@PathHelper.Pages.QuoteQwilrSignOff(Model.QuoteInfo.PublicGuid)">

  <table class="tblItems w100p">
    <thead>
      <tr>
        <th>Description</th>
        @if (Model.HasOptionals) { <th class="w50 pl0 pr0">&nbsp;</th> }
        <th class="w100 align-right pl0">Item</th>
        <th class="w50 align-center pl0 pr0">Qty</th>
        <th class="w125 align-right">Price (ex-GST)</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var quoteItem in Model.QuoteInfo.QuoteItems) {
        <tr class="item-row @(quoteItem.OptionalInfo.IsOptional ? "item-opt-yes" : "item-opt-no") @(quoteItem.ProductId == null ? "item-heading" : "")" data-item="@quoteItem.QuoteItemId">
          <td class="item-td-des">@Html.Raw(quoteItem.ItemDescription)</td>
          @if (Model.HasOptionals) { @Html.Raw("<td class=\"item-td-opt align-right pl0 pr0\">") }
          @Html.Raw(Model.GetOptionOrHidden(quoteItem))
          @if (Model.HasOptionals) { @Html.Raw("</td>") }
          <td class="item-td-amt align-right">@quoteItem.UnitPrice.ToString("C", "")</td>
          <td class="item-td-qty align-center pl0 pr0">@quoteItem.Quantity.ToString("0.##", "")</td>
          <td class="item-td-tot align-right pl0 item-linetotal" data-amount="@quoteItem.PriceXQty(null).ToStringOrEmptyIfNull()">@quoteItem.PriceXQty(null).ToString("C", "")</td>
        </tr>
        <tr><td colspan="5"><hr class="mt2 mb0 pt0 pb0"></td></tr>
      }
    </tbody>
  </table>

  <div class="footer">
    <p class="ex-gst-note">All amounts are ex-GST.</p>
    <table class="tblTotal w100p">
      <tr>
        <td><button type="submit" class="acceptbox">Accept</button></td>
        <td class="align-right"><div class="totalbox">Total: <span class="totalamt quote-total">@Model.TotalAmount.ToString("C")</span><span class="totalamt-exgst">ex-GST</span></div></td>
      </tr>
    </table>
  </div>

</form>

@section PostScriptContent {

  <script type="text/javascript">
    (function($) {

      $(document).ready(function () {

        $(".item-optional").change(function (ev) {
          var $chk = $(ev.target);
          var checked = $chk.is(":checked");
          var $row = $chk.closest("tr");
          var itemid = $row.data("item");
          if (!checked) {
            $row.addClass("unchecked");
          } else {
            $row.removeClass("unchecked");
          }
          RecalcTotal();
        });

        RecalcTotal();
      });

      function RecalcTotal() {
        var grandTotal = 0;
        var $rows = $(".item-row");
        for (var i = 0; i < $rows.length; i++) {
          var $row = $rows.eq(i);
          var $chk = $row.find(".item-optional");
          if ($chk.length == 0 || $chk.is(":checked")) {
            var lineTotal = parseFloat($row.find(".item-linetotal").data("amount")) || 0;
            grandTotal += lineTotal;
          }
        }
        $(".quote-total").text(CurrencyFormatter.format(grandTotal));

      }

    })(jQuery);
  </script>

}
