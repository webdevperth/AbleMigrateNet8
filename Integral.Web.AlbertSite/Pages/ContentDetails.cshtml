      function SaveContent(evt) {

        var contentForm = $("#contentForm");

        if (!ValidateContentForSaving()) return; // Some attachment is missing

        var submitData = {};
        if (currentContentType == contentType_Quiz && CanEditQuiz) {
          if (!ValidateQuizCreation()) return;
          submitData["@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizData"] = GetQuizDataForUpdate();
        }

        AjaxSubmit({
          form: contentForm,
          url: "@PathHelper.CurrentUrl",
          action: "@Integral.Web.PortalSite.Pages_Albert.ContentDetails.AjaxAction.UpdateContent",
          data: submitData,
          onSuccess: function (jqXHR, data) {

            contentGuid = data["@Integral.Web.PortalSite.Pages_Albert.ContentDetails.AjaxReturnData.ContentGuid"];

            // Upload files one after the other.
            SaveContentFile(true, false, () => {
              SaveContentFile(false, true, () => {
                document.location.reload();
              });
            });
          }
        });
      }

      function SubmitQuizResponses() {

        @if (!Model.CanSubmitQuizResponses) {
          <text>
          common_ErrorToast('Not allowed to submit responses.');
          return;
          </text>
        }

        var quizData = [];
        var $questionContainer = $('.question-container');

        // Check if there's at least one question
        if ($questionContainer.length === 0) {
          common_ErrorToast('No questions found in the quiz');
          return;
        }

        var validAnswers = false;

        $questionContainer.each(function (index) {
          var $questionId = $(this).find('.question').attr('data-@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizQuestion');
          var questionNum = index + 1;

          // Retrieve the value of the selected option
          var $selectedOption = $(this).find('.options .option.selected').attr('data-@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizOption');

          if ($selectedOption === 0 || $selectedOption == null || $selectedOption == 'undefined') {
            // No option selected
            currentQuizQuestion = index;
            DisplayQuizQuestion();
            common_ErrorToast('Please select an option for question ' + questionNum + '.');
            return false;

          } else {

            // Add to array
            quizData.push({
              questionId: $questionId,
              optionId: $selectedOption
            })

            validAnswers = true;

            return true;
          }
        });

        if (quizData == null || quizData.length == 0 || !validAnswers) {
          return;
        }

        var submitQuizForm = $("#SubmitQuizForm");
        var btnSubmitQuiz = $("#quizNextBtn");

        AjaxSubmit({
          form: submitQuizForm,
          url: "@PathHelper.CurrentUrl",
          action: "@Integral.Web.PortalSite.Pages_Albert.ContentDetails.AjaxAction.SubmitQuizResponses",
          data: {
            "@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizData": JSON.stringify(quizData)
          },
          onSuccess: function (jqXHR, data) {
            var quizResultsHtml = data["@Integral.Web.PortalSite.Pages_Albert.ContentDetails.AjaxReturnData.QuizResults"];
            if (quizResultsHtml != "" && quizResultsHtml != null) {
              $('.quiz-container').fadeOut(300, function () { // Fade out the current content
                $(this).empty(); // Clear the content
                $(this).html(quizResultsHtml); // Add new content
                common_UpdateUI($(this));
                $(this).fadeIn(300); // Fade in the new content
              });
            }
          },
          onFail: function (jqXHR, data) {
          },
          onError: function (jqXHR, textStatus, errorThrown) {
            common_InfoDialog("Submit failed, please try again later.");
          },
          onAlways: function (data_or_jqXHR, textStatus, jqXHR_or_errorThrown) {
            // Always runs after the Ajax call finishes
          }
        });
      }

      function ValidateQuizCreation() {
        var $questions = $('.question');

        // Check if there's at least one question
        if ($questions.length === 0) {
            common_ErrorToast('Please add at least one question to the quiz');
            return false;
        }

        $questions.each(function(index) {
          var $question = $(this);
          var $options = $question.find('.option');
          var questionNum = index + 1;

          // Check if question text is empty
          var questionText = $question.find('input[name="@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizQuestion"]').val().trim();
          if (!questionText) {
            common_ErrorToast(`Question ${questionNum} cannot be empty`);
            return false;
          }
          // Check if question has at least two options
          if ($options.length < 2) {
            common_ErrorToast(`Question ${questionNum} must have at least two options`);
            return false; // break the loop
          }

          // Check if any options are empty
          var hasEmptyOption = false;
          $options.find('input[type="text"]').each(function() {
            if (!$(this).val().trim()) {
                hasEmptyOption = true;
                return false; // break the loop
            }
          });

          if (hasEmptyOption) {
            common_ErrorToast(`All options for question ${questionNum} must be filled out`);
            return false;
          }

          // Check if a correct option is selected
          var $selectedOption = $question.find(`input[name="@(Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizCorrectOption)_${questionNum}"]:checked`);
          if ($selectedOption.length === 0) {
            common_ErrorToast(`Please select a correct option for question ${questionNum}`);
            return false; // break the loop
          }
        });

        return true;
      }

      function GetQuizDataForUpdate() {
        var quizData = [];
        $('.question').each(function(questionIndex) {
          var $question = $(this);
          var questionNum = questionIndex + 1;

          // Get question text
          var questionText = $question.find('input[name="@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizQuestion"]').val();

          // Get options and find the selected 'correct' option
          var options = [];
          var correctOptionIndex = -1;

          $question.find('.option').each(function (optionIndex) {
            var $option = $(this);
            var optionText = $option.find('input[type="text"]').val();
            options.push(optionText);

            // Check if this is the correct option
            if ($option.find(`input[name="@(Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.QuizCorrectOption)_${questionNum}"]`).is(':checked')) {
              correctOptionIndex = optionIndex;
            }
          });

          quizData.push({
            question: questionText,
            options: options,
            correctOptionIndex: correctOptionIndex
          });
        });

        return JSON.stringify(quizData);
      }

      function ValidateContentForSaving() {

        // Check that cover Image and attachment aren't missing
        var coverImagePath = '@Html.Raw(PathHelper.Images.ContentCoverImage(Model.ContentInfo.ContentGuid, PathHelper.Images.ContentCoverImageSize.Card))';
        var contentPath = '@Model.ContentFilePath';
        var missingImagePath = '@Html.Raw(PathHelper.Images.ContentImage_Missing())';

        if (isNewContent
          || (!isNewContent && coverImagePath == missingImagePath)
          || (!isNewContent && contentPath == "" && (currentContentType == contentType_Image || currentContentType == contentType_Document))) {

          var isAttachmentMissing = false;

          if (currentContentType == contentType_Image || currentContentType == contentType_Document) {
            var fileInput = $('#contentFileInput')[0].files[0];
            if (!fileInput && contentPath == "") {
              isAttachmentMissing = true;
              $('.error-contentFile').css('display', 'block'); // Show the error message
            } else {
              $('.error-contentFile').css('display', 'none'); // Hide the error message
              isUpdatingFiles = true;
            }
          }

          if ($imgCoverImage.data("blob") == null && allFieldsAreRequired) {
            isAttachmentMissing = true;
            $('.error-imgCover').css('display', 'block'); // Show the error message
          } else {
            $('.error-imgCover').css('display', 'none'); // Hide the error message
            isUpdatingFiles = true;
          }

          if (isAttachmentMissing) return false;
        }

        return true; // Passed validation
      }

      function SaveContentFile(isCoverImage, isLastUpload, fnCallback) {

        var formData = new FormData();
        formData.append("@PathHelper.AbleUrlKeys.ContentGuid", contentGuid);

        if (isCoverImage) {

          if ($imgCoverImage.data("blob") == null || contentGuid == null) {
            TryCallback();
            return;
          }

          formData.append("@PathHelper.FormKeys.AjaxAction", "@Integral.Web.PortalSite.Pages_Albert.ContentDetails.AjaxAction.UploadCoverImage");
          formData.append("image", $imgCoverImage.data("blob"));

        } else {

          if (currentContentType != contentType_Image && currentContentType != contentType_Document) {
            isUpdatingFiles = false;
            TryCallback();
            return;
          }

          var fileInput = $('#contentFileInput')[0].files[0];
          if (!fileInput) {
            TryCallback();
            return;
          }

          formData.append('file', fileInput);
          formData.append("@PathHelper.FormKeys.AjaxAction", "@Integral.Web.PortalSite.Pages_Albert.ContentDetails.AjaxAction.UploadFile");
        }

        formData.append("@Integral.Web.PortalSite.Pages_Albert.ContentDetails.FormFields.ContentGuid", contentGuid);

        $.busyLoadFull("show");

        jQuery.ajax({
          method: "post",
          url: "@PathHelper.CurrentUrl",
          data: formData,
          processData: false,
          contentType: false

        }).done(function (response) {

        }).always(() => {

          $.busyLoadFull("hide");
          TryCallback();
        });

        function TryCallback() {
          if (typeof fnCallback == "function") {
            fnCallback();
          } else {
            document.location.reload();
          }
        }
      }

      function DoPageRedirection() {
        if (isNewContent) {
          if (isProgramView) {
            window.location.href = '@Html.Raw(PathHelper.Pages.ProgramContent(Model.ProgramInfo?.ProgramJobId))';
          } else {
            window.location.href = '@Html.Raw(PathHelper.Pages.Content())';
          }
        }
      }

    })(jQuery);

  </script>

