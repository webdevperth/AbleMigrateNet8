@page
@model Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey
@{ Layout = "_Layout_AdminLTE"; }

<div class="container-fluid">

  <form class="form-horizontal" id="clientForm">

    <div class="form-group ajaxSubmit-field row surveyList">
      <label class="control-label col-md-3 col-sm-12 col-xs-12">Choose Survey To Send:</label>
      <div class="col-md-6 col-sm-12 col-xs-12">
        <select class="form-control" data-placeholder="survey template" id="selSurvey" name="@Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.SurveyId_FieldName" size="1">
          @Html.Raw(Model.GetSurveySelectOptions())
        </select>
      </div>
    </div>

    <div class="closeDates">

      @Html.Raw(WebHelper.GetInputDateRow("When to Send Survey:", Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.SendDate_FieldName,
        TimeHelper.UtcToAppDefaultTimeZone(DateTime.UtcNow).Value, 3, 9, "Select a future date<br/>to schedule delivery."))

      <div class="coacheeCloseDateArea">
        @Html.Raw(WebHelper.GetInputDateRow("Participant Close Date:", Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.SelfClose_FieldName,
          TimeHelper.UtcToAppDefaultTimeZone(DateTime.UtcNow).Value.AddDays(ConfigHelper.AbleSurveyDefaultOpenDays_Self), 3, 2, ""))
      </div>

      <div class="ratersCloseDateArea">
        @Html.Raw(WebHelper.GetInputDateRow("Rater (Final) Close Date:", Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.RaterClose_FieldName,
          TimeHelper.UtcToAppDefaultTimeZone(DateTime.UtcNow).Value.AddDays(ConfigHelper.AbleSurveyDefaultOpenDays_Rater), 3, 2, ""))
      </div>

    </div>

    @Html.Raw(WebHelper.GetTextDisplayRow("", @"
        <div class=""ratersOnlyMessage display-none"">Note: This is a ""Raters-Only"" survey.<br/>The survey will be sent to all raters in<br/>the participant's most recent 360 survey.</div>
        <div class=""noRatersMessage display-none"">Note: This survey requires no raters.<br />The participant will not be asked to select raters.</div>
        <div class=""mt20""><button type=""button"" id=""btnSend"" class=""btn btn-primary"">Send Survey Now</button></div>"))

  </form>
</div>

@section PostScriptContent {

  <script type="text/javascript">
    (function($) {

      var $clientForm = $("#clientForm");
      var btnSend, selSurvey, inpSelfClose, inpRaterClose, inpSendDate;
      var coacheeCloseDateArea, ratersCloseDateArea

      $(document).ready(function() {

        btnSend = $("#btnSend");
        selSurvey = $("#selSurvey");
        coacheeCloseDateArea = $(".coacheeCloseDateArea");
        ratersCloseDateArea = $(".ratersCloseDateArea");
        inpSelfClose = $('input[name="@Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.SelfClose_FieldName"]');
        inpRaterClose = $('input[name="@Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.RaterClose_FieldName"]');
        inpSendDate = $('input[name="@Integral.Web.PortalSite.Pages_Albert.ProgramSendSurvey.FormFields.SendDate_FieldName"]');

        btnSend.click(SendSurvey);

        selSurvey.change(SurveyChanged);
        SurveyChanged();

        inpSelfClose.change(function (e) {
          var addDays = @(ConfigHelper.AbleSurveyDefaultOpenDays_Rater - ConfigHelper.AbleSurveyDefaultOpenDays_Self);
          var date = moment(new Date($(this).val())); //.format("MMM Do YY");
          date = date.add(addDays, 'days')
          inpRaterClose.val(date.format("D MMM YYYY"));
        });

        inpSendDate.change(SendWhenChanged);
        SendWhenChanged();

      }); // ready.

      function SendWhenChanged() {
        var sendDate = new Date(inpSendDate.val());
        if (sendDate > new Date())
          btnSend.text("Schedule to Send on " + inpSendDate.val());
        else
          btnSend.text("Send Survey Now");
      }

      function SurveyChanged() {
        // Adjust options.
        var opt = selSurvey.find(":selected");
        if (opt.length != 1) return;
        var ratersOnly = (opt.data("ratersonly") == "1");
        var noRaters = (opt.data("noraters") == "1");

        if (ratersOnly) {
          coacheeCloseDateArea.slideUp(200);
          $(".noRatersMessage").slideUp(200);
          ratersCloseDateArea.slideDown(200);
          $(".ratersOnlyMessage").slideDown(200);
        } else if (noRaters) {
          ratersCloseDateArea.slideUp(200);
          $(".ratersOnlyMessage").slideUp(200);
          coacheeCloseDateArea.slideDown(200);
          $(".noRatersMessage").slideDown(200);
        } else {
          $(".ratersOnlyMessage").slideUp(200);
          $(".noRatersMessage").slideUp(200);
          coacheeCloseDateArea.slideDown(200);
          ratersCloseDateArea.slideDown(200);
        }
      }

      function SendSurvey() {

        common_ConfirmDialog("Confirm Send Survey to @Model.ProgramInfo.ParticipantCount Participants", btnSend.text() + "?",
          function (confirmed) {
            if (confirmed) SendSurveyConfirmed();
          }
        );

      }

      function SendSurveyConfirmed() {
        AjaxSubmit({ form: $clientForm });
      }

    })(jQuery);
  </script>

}
