@page "/Partials/CompanyReport_Categories"
@model Integral.Web.PortalSite.Page_Partials.CompanyReport_Categories
@{ Layout = null; }

@* Note requires reports.css *@

<div class="ctlCA360FT">

  <div class="table-responsive">

    <table class="table tblScores">
      <thead>
        <tr>
          <td class="cTitle minw250">Overall Leadership Indicators</td>
          <td class="cProg minw250">
            @(Model.SurveyStats.HasPreSurvey ? $"Pre-Post" : $"Comparison to {Integral.Web.PortalSite.Reports.OrgReports.Benchmark_Display_Text.UCaseFirstChar()}")
          </td>
          <td class="cFeedb minw200">Your Feedback</td>
        </tr>
      </thead>
      <tbody>

        @foreach (var category in Model.Categories) {

          <tr class="rowSkill rowid_@category.CategoryHeadingId @Model.GetBenchComparisonRowClass(category)">
            <td class="cTitle">@category.CategoryHeading.HTMLEncode()</td>
            <td class="cProg">
              <div class="progPts">
                @if (Model.SurveyStats.HasPreSurvey) {
                  <p>@Model.GetPrePostComparisonText(category.SelfPostScore, category.SelfPreScore)</p>
                  <p class="progPtsPre">@Model.GetPrePostComparisonText(category.RaterPostScore, category.RaterPreScore)</p>
                } else {
                  @Model.GetBenchComparisonText(category)
                }
              </div>
            </td>
            <td class="cFeedb">
              <div class="scoreBars">
                <div class="scoreBar">
                  <div class="barTitle">Self</div>
                  <div class="barBg">
                    <span class="barLine barSelf" @Html.Raw(Model.BarWidthStyle(category.SelfPostScore ?? category.SelfAllScore))></span>
                    <span class="barDot dotSelf" title="@Model.BenchmarkDisplayName Norm = @Model.GetScoreFormatted(category.SelfBenchScore)" @Html.Raw(Model.DotPosStyle(category.SelfBenchScore))></span>
                  </div>
                  <div class="barScore">@Model.GetScoreFormatted(category.SelfPostScore ?? category.SelfAllScore)</div>
                </div>
                @if (Model.SurveyStats.RaterAllCount > 0) {
                  <div class="scoreBar mt15">
                    <div class="barTitle">Rater</div>
                    <div class="barBg">
                      <span class="barLine barRater" @Html.Raw(Model.BarWidthStyle(category.RaterPostScore ?? category.RaterAllScore))></span>
                      <span class="barDot dotRater" title="@Model.BenchmarkDisplayName Norm = @Model.GetScoreFormatted(category.RaterBenchScore)" @Html.Raw(Model.DotPosStyle(category.RaterBenchScore))></span>
                    </div>
                    <div class="barScore">@Model.GetScoreFormatted(category.RaterPostScore ?? category.RaterAllScore)</div>
                  </div>
                }
              </div>
            </td>
          </tr>
        }

      </tbody>
    </table>
  </div>
</div>@* ctlCA360FT *@


<script type="text/javascript">

  (function ($) {

    $(document).ready(function () {
      new jBox('Tooltip', {
        attach: '.ctlCA360FT .barDot[title]', position: { y: 'top' }
      });
    });

  })(jQuery);

</script>
