@page "/Partials/SurveyViewer_Categories"
@model Integral.Web.PortalSite.Page_Partials.SurveyViewer_Categories
@{ Layout = null; }

@*-- Note requires reports.css --*@

<div class="ctlCA360FT">

  <div class="table-responsive">

    <table class="table tblScores">
      @*--
      <colgroup>
        <col width="400">
        <col width="350">
        <col width="">
      </colgroup>
      --*@
      <thead>
        <tr>
          <td class="cTitle minw250">Overall Leadership Indicators</td>
          @if (!Model.HideComparisonColumn) {
            <td class="cProg minw250">
              @(Model.HasPreSurvey ? $"Pre-Post" : $"Comparison to {Integral.Web.PortalSite.Reports.OrgReports.Benchmark_Display_Text.UCaseFirstChar()}")
            </td>
          }
          <td class="cFeedb minw200">@(Model.HideComparisonColumn ? "" : "Your Feedback")</td>
        </tr>
      </thead>
      <tbody>

        @foreach (var category in Model.Categories) {

          string surveySelfStyle = "style=\"width:" + WebHelper.GetCSSPercentFromRatio(category.SurveySelfScore, category.CategoryMaxScore) + "\"";
          string surveyRaterStyle = "style=\"width:" + WebHelper.GetCSSPercentFromRatio(category.SurveyRaterScore, category.CategoryMaxScore) + "\"";
          string normSelfStyle = "style=\"left:" + WebHelper.GetCSSPercentFromRatio(category.NormSelfScore, category.CategoryMaxScore) + "\"";
          string normRaterStyle = "style=\"left:" + WebHelper.GetCSSPercentFromRatio(category.NormRaterScore, category.CategoryMaxScore) + "\"";

          <tr class="rowSkill rowid_@category.CategoryHeadingId @Model.GetBenchComparisonRowClass(category)">
            <td class="cTitle">@category.CategoryHeading.HTMLEncode()</td>
            @if (!Model.HideComparisonColumn) {
              <td class="cProg">
                <div class="progPts">
                  @if (Model.HasPreSurvey) {
                    <p>@Model.GetPrePostComparisonText(category.SurveySelfScore, category.PreSurveySelfScore)</p>
                    <p class="progPtsPre">@Model.GetPrePostComparisonText(category.SurveyRaterScore, category.PreSurveyRaterScore)</p>
                  } else {
                    @Model.GetBenchComparisonText(category)
                  }
                </div>
              </td>
            }
            <td class="cFeedb">
              <div class="scoreBars">
                <div class="scoreBar">
                  <div class="barTitle">Self</div>
                  <div class="barBg">
                    <span class="barLine barSelf" @Html.Raw(surveySelfStyle)></span>
                    <span class="barDot dotSelf" title="@Model.NormDisplayName Norm = @Model.GetScoreFormatted(category.NormSelfScore)" @Html.Raw(normSelfStyle)></span>
                  </div>
                  <div class="barScore">@Model.GetScoreFormatted(category.SurveySelfScore)</div>
                </div>
                @if (Model.RaterCount > 0) {
                  <div class="scoreBar mt15">
                    <div class="barTitle">Rater</div>
                    <div class="barBg">
                      <span class="barLine barRater" @Html.Raw(surveyRaterStyle)></span>
                      <span class="barDot dotRater" title="@Model.NormDisplayName Norm = @Model.GetScoreFormatted(category.NormRaterScore)" @Html.Raw(normRaterStyle)></span>
                    </div>
                    <div class="barScore">@Model.GetScoreFormatted(category.SurveyRaterScore)</div>
                  </div>
                }
              </div>
            </td>
          </tr>
        }

      </tbody>
    </table>
  </div>
</div>@*-- ctlCA360FT --*@


<script type="text/javascript">

  (function ($) {

    $(document).ready(function () {
      new jBox('Tooltip', {
        attach: '.ctlCA360FT .barDot[title]', position: { y: 'top' }
      });
    });

  })(jQuery);

</script>
