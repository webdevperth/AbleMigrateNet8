@page "/Partials/SurveyViewer_Overview"
@model Integral.Web.PortalSite.Page_Partials.SurveyViewer_Overview
@{ Layout = null; }

<div class="ctlCA360SoT h100pc">

  <div class="flex gap15 flex-column-sm h100pc">

    <div class="boxBorder">
      <div class="boxTitle"><h4>@Model.GetOverallBoxTitle()</h4></div>
      <div class="boxBody boxScores boxBgBottom">
        @if (Model.SelfCount > 0) {
          <div class="scoreRow">
            <div class="scoreAcross scoreLeft">
              <div class="score">@Model.GetScoreFormatted(Model.ScoreSelf, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
              <div class="barOuter"><div class="bar"></div></div>
              <div class="subtitle">Self@(Model.SelfCount == 1 ? "" : $" ({Model.SelfCount})")</div>
            </div>
            <div class="scoreAcross scoreRight">
              <div class="score">@Model.GetScoreFormatted(Model.NormSelf, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
              <div class="barOuter"><div class="bar"><span>..........</span></div></div>
              <div class="subtitle">Self Norm<div class="benchTypeName">(@Model.NormDisplayName)</div></div>
            </div>
          </div>
        }
        @if (Model.RaterCount > 0) {
          <div class="scoreRow raterRow">
            <div class="scoreAcross scoreLeft">
              <div class="score">@Model.GetScoreFormatted(Model.ScoreRater, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
              <div class="barOuter"><div class="bar"></div></div>
              <div class="subtitle">Rater (@Model.RaterCount)</div>
            </div>
            <div class="scoreAcross scoreRight">
              <div class="score">@Model.GetScoreFormatted(Model.NormRater, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
              <div class="barOuter"><div class="bar"><span>..........</span></div></div>
              <div class="subtitle">Rater Norm<div class="benchTypeName">(@Model.NormDisplayName)</div></div>
            </div>
          </div>
        }
      </div>
    </div>

    @if (Model.SinglePreSurveyPartId > 0) {
      <div class="boxBorder">
        <div class="boxTitle"><h4>Pre-Post Scores</h4></div>
        <div class="boxBody boxScores boxBgBottom">
          @if (Model.SelfCount > 0) {
            <div class="scoreRow">
              @if (Model.SinglePreSurveyPartId > 0) {
                <div class="scoreAcross scoreLeft">
                  <div class="score">@Model.GetScoreFormatted(Model.PreSurveyScoreSelf, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
                  <div class="barOuter"><div class="bar"></div></div>
                  <div class="subtitle">Pre-Survey<br/>Self</div>
                </div>
              }
              <div class="scoreAcross scoreLeft">
                <div class="score">@Model.GetScoreFormatted(Model.ScoreSelf, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
                <div class="barOuter"><div class="bar"></div></div>
                <div class="subtitle">Post-Survey<br/>Self@(Model.SelfCount == 1 ? "" : $" ({Model.SelfCount})")</div>
              </div>
              <div class="scoreAcross scoreRight">
                <div class="score">@Model.GetScoreFormatted(Model.ScoreSelf - Model.PreSurveyScoreSelf, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
                <div class="barOuter"><div class="bar"><span>..........</span></div></div>
                <div class="subtitle">Pre-Post<br/>Self Change</div>
              </div>
            </div>
          }
          @if (Model.RaterCount > 0) {
            <div class="scoreRow raterRow">
              @if (Model.SinglePreSurveyPartId > 0) {
                <div class="scoreAcross scoreLeft">
                  <div class="score">@Model.GetScoreFormatted(Model.PreSurveyScoreRater, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
                  <div class="barOuter"><div class="bar"></div></div>
                  <div class="subtitle">Pre-Survey<br/>Rater (@Model.PreSurveyRaterCount)</div>
                </div>
              }
              <div class="scoreAcross scoreLeft">
                <div class="score">@Model.GetScoreFormatted(Model.ScoreRater, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
                <div class="barOuter"><div class="bar"></div></div>
                <div class="subtitle">Post-Survey<br/>Rater (@Model.RaterCount)</div>
              </div>
              <div class="scoreAcross scoreRight">
                <div class="score">@Model.GetScoreFormatted(Model.ScoreRater - Model.PreSurveyScoreRater, "NA")<span class="sub"> / @Model.ScoreMaxValue</span></div>
                <div class="barOuter"><div class="bar"><span>..........</span></div></div>
                <div class="subtitle">Pre-Post<br/>Rater Change</div>
              </div>
            </div>
          }
        </div>
      </div>
    }

    @if (Model.CanShowAISummaryText && !Model.AISummaryText.IsNullOrEmpty()) {
      <div class="boxBorder ai-summary-box">
        <div class="boxTitle"><h4>360&deg; Feedback Summary</h4></div>
        <div class="boxBody nicer-scrollbar">@Html.Raw(WebHelper.MarkdownToHtml(Model.AISummaryText))</div>
      </div>
    }

  </div>
</div>

<script>

  (function ($) {

    $(document).ready(function () {


    }); // Doc ready.

  })(jQuery);

</script>
