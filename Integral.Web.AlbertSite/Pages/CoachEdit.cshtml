@page
@model Integral.Web.PortalSite.Pages_Albert.CoachEdit
@{ Layout = "_Layout_AdminLTE"; }

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

@Html.Raw(Model.GetPageTabs())

<div class="tab-panel" data-appendTo="panel-@PathHelper.CoachTabEnum.profile">
  @Html.Raw(new WebHelper.Form.SectionTitle() {
      TitleText = "Profile",
      HelpText = "Your personal profile and settings.",
      HelpLinkUrl = "https://help.helloable.co/en/articles/12504233-complete-your-profile",
    }.ToHtml())

  <form class="form-horizontal" id="clientForm">

    <input type="hidden" name="@PathHelper.FormKeys.AjaxAction" value="@Integral.Web.PortalSite.Pages_Albert.CoachEdit.AjaxAction.UpdateProfile" />
    <input type="hidden" name="CoachUserId" value="@(Model.IsNewCoach ? "new" : Model.CoachInfo.UserId.ToString())" />

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Profile Image:",
        LabelHelpText = "Image must be PNG or JPEG and under 10MB",
        ContentHtml = Model.ProfileImageControl.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Your Name: ",
        ContentHtml = new WebHelper.Form.TextInputDual() {
          IsReadOnly = !Model.CanEditProfile,
          Input1Name = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.FirstName,
          Input1Value = Model.CoachInfo.FirstName,
          Input2Name = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.LastName,
          Input2Value = Model.CoachInfo.LastName
        }.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Email Address:",
        LabelHelpText = "Visible to your clients, team and other partners.",
        ContentHtml = new WebHelper.Form.TextInput() {
          IsReadOnly = !Model.CanEditProfile,
          InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.EmailAddress,
          Value = Model.CoachInfo.EmailAddress.HTMLEncode(),
          Attributes = Model.ProfileReadOnlyAttr,
          Type = "email"
        }.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Mobile Number:",
        LabelHelpText = "Visible to your clients and team.",
        ContentHtml = new WebHelper.Form.TextInput() {
          IsReadOnly = !Model.CanEditProfile,
          InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.MobileNumber,
          Value = Model.CoachInfo.MobileNumber.HTMLEncode(),
          Attributes = Model.ProfileReadOnlyAttr
        }.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Location:",
        LabelHelpText = "Visible to your clients, team and other partners.",
        ContentHtml = new WebHelper.Form.TextInputDual() {
          IsReadOnly = !Model.CanEditProfile,
          Input1Name = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.City,
          Input1Value = Model.CoachInfo.City,
          Input1Placeholder = "City",
          Input2Name = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.Country,
          Input2Value = Model.CoachInfo.Country,
          Input2Placeholder = "Country"
        }.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Role Title:",
        ContentHtml = new WebHelper.Form.TextInput() {
          InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.RoleTitle,
          Value = Model.CoachInfo.RoleTitle.HTMLEncode(),
          IsReadOnly = !Model.CanEditProfile
        }.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Org Role:",
        ContentHtml = new WebHelper.Form.Select() {
          IsReadOnly = !Model.CanEditProfile,
          InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.OrgRoleId,
          TopOptionsHtml = Model.GetOrgRolesOptions()
        }.ToHtml()
      }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Time Zone:",
        LabelHelpText = "Emails are delivered based on your Timezone",
        ContentHtml = new WebHelper.Form.Select() {
          InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.TimeZoneIdIana,
          TopOptionsHtml = Model.GetTimeZoneOptions(),
          IsReadOnly = !Model.CanEditProfile
        }.ToHtml()
      }.ToHtml())

    @if (Model.CanViewProfileUrls) {

      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelText = "Calendly Url:",
          LabelHelpText = "Your Calendly url to connect to your calendars.",
          LabelHelpUrl = "https://help.helloable.co/en/articles/11967865-setup-your-calendar",
          ContentHtml = new WebHelper.Form.TextInput() {
            IsReadOnly = !Model.CanEditProfile,
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.CalendlyUrlName,
            Value = Model.CoachInfo.CalendlyUrlName.HTMLEncode(),
            Attributes = Model.ProfileReadOnlyAttr,
            LeftSideLabelText = "https://calendly.com/",
            RightSideLabelText = "/coaching-XXmin",
          }.ToHtml()
        }.ToHtml())

      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelText = "Your Profile:",
          LabelHelpText = "This link will appear as a link for others.",
          ContentHtml = new WebHelper.Form.TextInput() {
            IsReadOnly = !Model.CanEditProfile,
            LeftSideLabelText = "https://",
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.WebProfileUrl,
            Value = Model.CoachInfo.WebProfileUrl.RegexReplace("https?://", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).HTMLEncode(),
            Attributes = Model.ProfileReadOnlyAttr
          }.ToHtml()
        }.ToHtml())

    }

    @Html.Raw(new WebHelper.Form.SectionTitle() {
        TitleText = "Profile Status",
    }.ToHtml())

    @Html.Raw(new WebHelper.Form.FormRow() {
        LabelText = "Partner Status:",
        LabelPosition = WebHelper.Form.LabelPosition.LeftWide,
        ContentAlign = WebHelper.Form.ContentAlign.Right,
        LabelHelpText = @"Your profile is automatically active and published in the Partner network for other practitioners and organisations to see,
                          unless you are a member of a team and then you may need to complete onboarding activities before your profile is active.",
        ContentHtml = "<p class='font-weight-bold'>" + (Model.CoachInfo.IsPartnerActive ? "Active" : "Inactive") + "</p>",
      }.ToHtml())

    @if (Model.CanViewAndEditHideProfileToggle) {
      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelText = "Hide Profile:",
          LabelPosition = WebHelper.Form.LabelPosition.LeftWide,
          ContentAlign = WebHelper.Form.ContentAlign.Right,
          LabelHelpText = "This will hide your profile from the partner list. Your profile is still visible in other areas and you can be added to programs or quotes.",
          ContentHtml = new WebHelper.Form.CheckBox() {
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.HideProfile,
            Checked = Model.CoachInfo.IsProfileHidden,
            IsReadOnly = !Model.CanViewAndEditHideProfileToggle,
          }.ToHtml()
        }.ToHtml())
    }

    @if (Model.CanUpdateCoachRoleFlags) {

      @Html.Raw(new WebHelper.Form.SectionTitle() {
          TitleText = "User Roles",
          HelpText = "Select the account types you would like to access. Only people with permission to invite members can see this.",
          HelpLinkUrl = "https://help.helloable.co/en/articles/12087331-able-account-types",
        }.ToHtml())

      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelText = "Practitioner",
          LabelHelpText = "An account type for L&D providers eg. coaches & facilitators. This is your default account.",
          LabelPosition = WebHelper.Form.LabelPosition.LeftWide,
          ContentAlign = WebHelper.Form.ContentAlign.Right,
          ContentHtml = new WebHelper.Form.CheckBox() {
            IsReadOnly = !Model.CanEditProfile,
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.UserRole_IsPractitioner,
            Checked = Model.CoachInfo.IsAbleCoach,
          }.ToHtml()
        }.ToHtml())

      @Html.Raw(new WebHelper.Form.FormRow() {
          RowTopMargin = WebHelper.Form.RowTopMargin.None,
          LabelText = "Client",
          LabelHelpText = "An account type for client organisations.",
          LabelPosition = WebHelper.Form.LabelPosition.LeftWide,
          ContentAlign = WebHelper.Form.ContentAlign.Right,
          ContentHtml = new WebHelper.Form.CheckBox() {
            IsReadOnly = !Model.CanEditProfile,
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.UserRole_IsClient,
            Checked = Model.CoachInfo.IsAbleClient,
          }.ToHtml()
        }.ToHtml())

      @Html.Raw(new WebHelper.Form.FormRow() {
          RowTopMargin = WebHelper.Form.RowTopMargin.None,
          LabelText = "Leader",
          LabelHelpText = "An account type for learners and program participants. Some types require a paid Plan.",
          LabelPosition = WebHelper.Form.LabelPosition.LeftWide,
          ContentAlign = WebHelper.Form.ContentAlign.Right,
          ContentHtml = new WebHelper.Form.CheckBox() {
            IsReadOnly = !Model.CanEditProfile,
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.UserRole_IsParticipant,
            Checked = Model.CoachInfo.IsParticipant,
          }.ToHtml()
        }.ToHtml())

    }

    @if (Model.CanEditProfile) {
      <div class="row mt30">
        <div class="col-lg-8 col-md-12">
          @if (Model.CanDeleteUser && !Model.CoachInfo.IsSoftDeleted) {
            <button type="button" class="btn btn-warning btnDelete floatleft" id="btnBlockLogin">Block Login</button>
          } else if (Model.CoachInfo.IsSoftDeleted) {
            @Html.Raw(WebHelper.GetStatusBadge("Login Blocked"))
          }
          <button type="button" id="btnUpdateProfile" class="btn btn-primary floatright" data-waitmsg="Updating...">@(Model.IsNewCoach ? "Add Coach" : "Update Details")</button>
        </div>
      </div>
    }

  </form>
</div>

@if (Model.CanViewParticipantsTabs) {

  <div class="tab-panel" data-appendTo="panel-@PathHelper.CoachTabEnum.engageSetting">

    <form class="form-horizontal" id="engageSettingsForm">

      <input type="hidden" name="@PathHelper.FormKeys.AjaxAction" value="@Integral.Web.PortalSite.Pages_Albert.CoachEdit.AjaxAction.UpdateEngageSettings" />

      <div class="row mb10"><div class="col-md-6"><h4>Engage Settings</h4></div></div>

      @Html.Raw(WebHelper.GetYesNoButtons("Enable Nudges:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.EnableNudges, !Model.CoachInfo.LatestCoacheeInfo.DisableNudges, !Model.CanEditParticipantsSettings))
      @Html.Raw(Model.GetEnablePulseOptions("Enable Pulse:"))

      @if (Model.CanEditParticipantsSettings) {
        <div class="row mt30">
          <div class="col-md-12">
            <button type="button" id="btnUpdateSettings" class="btn btn-primary floatright" data-waitmsg="Updating...">Update</button>
          </div>
        </div>
      }
    </form>
  </div>

} else if (Model.CanViewNonProfileTabs) {

  <div class="tab-panel" data-appendTo="panel-@PathHelper.CoachTabEnum.bio">

    <form class="form-horizontal container" id="bioForm">

      <input type="hidden" name="@PathHelper.FormKeys.AjaxAction" value="@Integral.Web.PortalSite.Pages_Albert.CoachEdit.AjaxAction.UpdateBio" />

      @Html.Raw(new WebHelper.Form.SectionTitle() { TitleText = "Partner Bio" }.ToHtml())

      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelText = "Short Bio:",
          LabelHelpText = "A short snippet so people know who you are.",
          LabelPosition = WebHelper.Form.LabelPosition.Above,
          Classes = "mb40 mt40",
          ContentHtml = new WebHelper.Form.TextArea() {
            IsReadOnly = !Model.CanEditProfile,
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.BioShort,
            Value = Model.CoachInfo.BioShort
          }.ToHtml()
        }.ToHtml())

      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelText = "Bio for Cards:",
          LabelPosition = WebHelper.Form.LabelPosition.Above,
          Classes = "mb40 mt40",
          ContentHtml = new WebHelper.Form.TextArea() {
            IsReadOnly = !Model.CanEditProfile,
            InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.CoachCardBio,
            Value = Model.CoachInfo.PartnerBio_CoachCardBio
          }.ToHtml()
        }.ToHtml())

      @if (Model.CanViewIntegralBio) {

        @Html.Raw(new WebHelper.Form.SectionTitle() {
            TitleText = "Integral Bio",
            BottomMargin = false
          }.ToHtml())

        <div class="row mb30">
          <div class="col-md-8">
            <p>
              As a partner at Integral we need to know you, and be able to post information on our website and send
              (as needed) information to our clients. We'd like to know <b>you</b> and the business side of <b>you</b>.
            </p>
            <p>
              <b>In your personal voice ("I"), please comment on the following items - one or two paragraphs at most.</b>
              (Please remember we are putting you forward as a coach/facilitator, so it must be relevant
              to the work we are trying to win for you.)
            </p>
          </div>
        </div>

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "Background:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30 mt30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Personal_Background,
              Value = Model.CoachInfo.PartnerBio_Personal_Background
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "My Why:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Personal_MyWhy,
              Value = Model.CoachInfo.PartnerBio_Personal_MyWhy
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "How I work:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Personal_WhatIDo,
              Value = Model.CoachInfo.PartnerBio_Personal_WhatIDo
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "What I love:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Personal_WhatILove,
              Value = Model.CoachInfo.PartnerBio_Personal_WhatILove
            }.ToHtml()
          }.ToHtml())

        <hr />

        <div class="row mb30">
          <div class="col-md-8">
            <p>
              <b>In the third person (using "he", "she", or "they"), respond below with no more than two paragraphs each:</b>
            </p>
          </div>
        </div>

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "High Level Introduction",
            LabelHelpText = "Sentence on your contributions as a coach / facilitator, most notable accreditation and greatest client achievement:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Professional_Introduction,
              Value = Model.CoachInfo.PartnerBio_Professional_Introduction
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "Leadership Experience:",
            LabelHelpText = "Your experience as a leader or could could contain some similar qualities as those pretend above in personal voice",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Professional_Background,
              Value = Model.CoachInfo.PartnerBio_Professional_Background
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "Strengths in Coaching and Facilitating:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Professional_Strengths,
              Value = Model.CoachInfo.PartnerBio_Professional_Strengths
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "Recent Work:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Professional_RecentWork,
              Value = Model.CoachInfo.PartnerBio_Professional_RecentWork
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "Professional Impact:",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Professional_Impact,
              Value = Model.CoachInfo.PartnerBio_Professional_Impact
            }.ToHtml()
          }.ToHtml())

        @Html.Raw(new WebHelper.Form.FormRow() {
            LabelText = "Accreditations and Credentials:",
            LabelHelpText = "(List in bullet points)",
            LabelPosition = WebHelper.Form.LabelPosition.Above,
            Classes = "mb30",
            ContentHtml = new WebHelper.Form.TextArea() {
              IsReadOnly = !Model.CanEditProfile,
              InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerBio_Professional_Credentials,
              Value = Model.CoachInfo.PartnerBio_Professional_Credentials
            }.ToHtml()
          }.ToHtml())

      }

      @if (Model.CanEditProfile) {
        <div class="row mt30">
          <div class="col-lg-8 col-md-12">
            <button type="button" id="btnUpdateBio" class="btn btn-primary floatright" data-waitmsg="Updating...">Update Bio</button>
          </div>
        </div>
      }

    </form>
  </div>

  <div class="tab-panel" data-appendTo="panel-@PathHelper.CoachTabEnum.partnertags">

    <div class="row mb10"><div class="col-md-6"><h4>Partner Tags</h4></div></div>

    <form class="form-horizontal" id="partnerTagsForm">

      @foreach (var categoryTag in Model.CategoryTagsList) {
        <div class="form-group ajaxSubmit-field row">
          <label class="control-label col-md-2 col-sm-12 col-xs-12">
          @categoryTag.CategoryName
          </label>
          <div class="col-md-5 col-sm-12 col-xs-12">
            <select multiple="" class="form-control" style="width:100%;" name="@Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.PartnerTagCategoryIdPrefix" @(Model.CanChangeTags ? "" : "disabled=\"\"") >
              @foreach (var tag in categoryTag.TagInfoList) {
                var canUpdateTag = tag.PartnerCanEdit || (!tag.PartnerCanEdit && SessionHelper.IsUserRoleAdmin);
                @Html.Raw($"<option {(canUpdateTag ? "" : "disabled")} value=\"{tag.TagId}\"{(tag.IsSelected ? " selected" : string.Empty)}>{tag.TagName.HTMLEncode()}</option>")
              }
            </select>
          </div>
        </div>
      }

      @if (Model.CanChangeTags) {
        <div class="row form-group mt30">
          <div class="col-md-8">
            <button type="button" id="btnUpdatePartnerTags" class="btn btn-primary floatright" data-waitmsg="Updating..."> Update Tags</button>
          </div>
        </div>
      }

    </form>
  </div>

  <div class="tab-panel" data-appendTo="panel-@PathHelper.CoachTabEnum.company">

    <div class="row mb10"><div class="col-md-6"><h4>Company</h4></div></div>

    <form class="form-horizontal" id="companyForm">

      @Html.Raw(WebHelper.GetTextInput("Company Name:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.CompanyName, Model.TenantOrgInfo.OrgName, 5, Model.GoToOwnerLinkHtml, !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetTextInput("Company Friendly Name:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.CompanyFriendlyName, Model.TenantOrgInfo.OrgFriendlyName, 5, "", !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetTextInput("Bus. Identification Number:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.BusinessIdNumber, Model.TenantOrgInfo.BusinessIDNumber, 3, "", !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetTextInput("Contact Phone Number:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.ContactPhoneNumber, Model.TenantOrgInfo.OrgPhone, 3, "", !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetTextInput("General Email:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.GeneralEmail, Model.TenantOrgInfo.OrgEmail, 5, "", !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetTextInput("Website URL:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.WebSiteURL, Model.TenantOrgInfo.WebSiteURL, 5, "", !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetFormSubheader("Custom Sender Email"))
      @Html.Raw(WebHelper.GetTextInput("Sender Email Name:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.GenericSenderEmailName, Model.TenantOrgInfo.GenericSenderEmailName, 5, "", !Model.CanEditCompany))
      @Html.Raw(WebHelper.GetTextInput("Sender Email Address:", Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.GenericSenderEmailAddress, Model.TenantOrgInfo.GenericSenderEmailAddress, 5, "", !Model.CanEditCompany))

      @Html.Raw(new WebHelper.Form.FormRow() {
          LabelPosition = WebHelper.Form.LabelPosition.LeftLegacy,
          RowTopMargin = WebHelper.Form.RowTopMargin.Larger2,
          LabelText = "Company Logo:",
          LabelHelpText = "Image must be PNG or JPEG and under 10MB",
          ContentHtml = Model.CompanyLogoControl.ToHtml()
        }.ToHtml())

      <div class="row form-group mt30">
        <label class="control-label col-md-2 col-sm-12 col-xs-12"></label>
        <div class="col-md-5 col-sm-12 col-xs-12">
          <div class="floatright">
            @if (Model.CanEditCompany) {
              @Html.Raw(WebHelper.GetButton("Update Details", "btnUpdateCompany"))
            }
          </div>
        </div>
        <div class="col-md-5 col-sm-12 col-xs-12"></div>
      </div>
    </form>
  </div>

  <div class="tab-panel" data-appendTo="panel-@PathHelper.CoachTabEnum.partners">

    <div class="flex flex-fill mb20">
      <div><h4>Company Partners</h4></div>
      @if (Model.CanInvitePartners) {
        <div class="align-right"><button class="btn btn-primary" id="btnInvitePartner">Invite Partner</button></div>
      }
    </div>

    @if (Model.CanInvitePartners) {

      <div id="divInvitePartner" class="hidden">

        <form id="formInvitePartner" method="post" action="#" onsubmit="return false;">

          <input type="hidden" name="@PathHelper.FormKeys.AjaxAction" value="@Integral.Web.PortalSite.Pages_Albert.CoachEdit.AjaxAction.SendInvite" />

          <div class="table-responsive">
            <table class="tbl-form table borderless width-auto align-top">
              <tr class="ajaxSubmit-field">
                <td class="w125 align-right pt15">First Name:</td>
                <td class="w400">@Html.Raw(WebHelper.GetTextInput(new WebHelper.TextInputSettings() { InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.FirstName, NoRow = true }))
                  <div class="@WebHelper.CSSClasses.AjaxFieldErrorMsg"></div>
                </td>
              </tr>
              <tr class="ajaxSubmit-field">
                <td class="align-right pt15">Last Name:</td>
                <td>@Html.Raw(WebHelper.GetTextInput(new WebHelper.TextInputSettings() { InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.LastName, NoRow = true }))
                  <div class="@WebHelper.CSSClasses.AjaxFieldErrorMsg"></div>
                </td>
              </tr>
              <tr class="ajaxSubmit-field">
                <td class="align-right pt15">Email:</td>
                <td>@Html.Raw(WebHelper.GetTextInput(new WebHelper.TextInputSettings() { InputName = Integral.Web.PortalSite.Pages_Albert.CoachEdit.FormFields.EmailAddress, NoRow = true }))
                  <div class="@WebHelper.CSSClasses.AjaxFieldErrorMsg"></div>
                </td>
              </tr>
              <tr>
                <td></td>
                <td>
                  <div class="flex flex-fill">
                    <div><button class="btn btn-secondary" id="btnCancelInvite" tabindex="-1">Cancel</button></div>
