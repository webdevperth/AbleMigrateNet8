@page
@model Integral.Web.PortalSite.Pages_Albert.Organisations
@{ Layout = "_Layout_AdminLTE"; }

<div class="content-action-bar">
  <div class="left">
    <div class="status-toggle input-group" id="btnGrpActive" data-toggle="buttons">
      <label class="btn @(Model.searchInfo.StatusInactive ? "" : "active")"><input type="radio" name="toggleActive" value="@PathHelper.AbleUrlValues.Organisation_Active" @(Model.searchInfo.StatusInactive ? "" : "checked") />Active</label>
      <label class="btn @(Model.searchInfo.StatusInactive ? "active" : "")"><input type="radio" name="toggleActive" value="@PathHelper.AbleUrlValues.Organisation_Inactive" @(Model.searchInfo.StatusInactive ? "checked" : "") />Inactive</label>
    </div>
    <div class="search-input">
      <i class="fa fa-search"></i>
      <input type="text" id="txtSearch" name="@PathHelper.AbleUrlKeys.OrganisationSearchTerm" value="" placeholder="Search name, city, sector..." autofocus="autofocus">
    </div>
  </div>
  <div class="right">
    @if (Model.CanCreateCompany) {
      <a class="btn btn-primary floatright ml10" href="@PathHelper.Pages.Organisation_Add()">New Organisation</a>
    }
  </div>
</div>

<div class="table-responsive">
  <table class="table table-bordered table-hover table-rowlink limit-width" data-rowlink-url="">
    <thead>
      <tr>
        <th class="type-company-name">Organisation Name</th>
        <th class="type-user-nameWithAvatar">Client Lead</th>
        <th class="type-qty-lg">Programs <br />Active / Total</th>
        <th class="type-qty-lg">Participants <br /> Active / Total</th>
        <th class="type-qty-lg">Subscriptions <br /> Active / Total</th>
        <th class="type-qty-lg">Onboarding <br /> Score</th>
        <th class="type-revenueprogress">
          <div class="flex-inline">
            Total Delivery Revenue
            @Html.Raw(WebHelper.GetIconTooltip(WebHelper.ActionButtonTypeEnum.info, "Includes Only Active Programs", "", "ml5"))
          </div>
        </th>
        <th class="type-money-lg">Total Deals Outstanding</th>
        <th class="type-money-lg">Total Deals Won</th>
      </tr>
    </thead>
    <tbody id="OrgListBody">
    </tbody>
  </table>
</div>

@section PostScriptContent {

  <script type="text/javascript">
    (function($) {
      var $orgListBody = $('#OrgListBody');
      var btnGrpActive = $("#btnGrpActive");
      var txtSearch = $("#txtSearch");
      var keyTimeout = null, currentSearchValue, currentActiveToggleValue;

      $(document).ready(function() {

        currentSearchValue = "";
        currentActiveToggleValue = "";

        SetActiveToggleValue(@Html.Raw(SessionHelper.AppState.Organisations.Search_StatusInactive.ToJSTrueFalse()));
        txtSearch.val("@SessionHelper.AppState.Organisations.Search_SearchFor");

        btnGrpActive.on("change", "input:checked", ActiveToggled);
        txtSearch.keyup(SearchKeyUp);
        SearchKeyTimeout(txtSearch, true); // Get initial results.

      }); // ready

      function SetActiveToggleValue(statusInactive) {
        var btn;
        if (statusInactive === true) {
          btn = btnGrpActive.find('input[value="@PathHelper.AbleUrlValues.Organisation_Inactive"]');
        } else {
          btn = btnGrpActive.find('input[value="@PathHelper.AbleUrlValues.Organisation_Active"]');
        }

        if (btn.length === 1) {
          btn.trigger("click");
        }
      }

      function GetActiveToggleValue() {
        $checked = btnGrpActive.find("input:checked");
        if ($checked.length != 1) return "";
        return $checked.val();
      }

      function ActiveToggled(evt) {
        SearchKeyTimeout(txtSearch, true);
      }

      function SearchKeyUp(ev, data) {
        var isImmediate = (data && data.immediate);
        var $inp = $(ev.target);
        if (keyTimeout) clearTimeout(keyTimeout);
        if (isImmediate) SearchKeyTimeout($inp, isImmediate);
        else keyTimeout = setTimeout(function () { keyTimeout = null; SearchKeyTimeout($inp, isImmediate); }, 800);
      }

      function SearchKeyTimeout($inp, isImmediate) {

        var newSearchValue = "" + $inp.val();
        var newActiveToggleValue = GetActiveToggleValue();
        var minLength = @Integral.Web.PortalSite.Pages_Albert.Organisations.Min_Search_Length;

        if (newSearchValue === currentSearchValue
          && newActiveToggleValue === currentActiveToggleValue
          && isImmediate !== true) return;

        if (newSearchValue.length > 0 && newSearchValue.length < minLength) {
          return;
        }

        currentSearchValue = newSearchValue;
        currentActiveToggleValue = newActiveToggleValue;

        $.busyLoadFull("show");

        $.get(location.pathname,
          {
            "@PathHelper.AbleUrlKeys.OrganisationSearchTerm": encodeURIComponent(currentSearchValue),
            "@PathHelper.AbleUrlKeys.OrganisationStatusToggle": encodeURIComponent(currentActiveToggleValue)
          },
          function (data, status, jqXHR) {
            PopulateTableBody(data);
          },
          "json")
          .fail(function () { alert("Oops, there was a problem!"); })
          .always(function () { $.busyLoadFull("hide"); });
      }

      function PopulateTableBody(data) {

        $orgListBody.empty();

        if (!data || !data.length) {
          $orgListBody.append($("<tr>").append($("<td>").attr("colspan", 6).text("No results found.")));
          return;
        }

        for (var i = 0; i < data.length; i++) {
          var thisOrg = data[i];

          var row = $("<tr>").attr("data-rowlink-url", thisOrg.RowLinkUrl);

          var companyName = $("<td>").text(thisOrg.CompanyName).addClass("type-company-name");

          var avatarDiv = $("<div>").html(thisOrg.ClientLeadHtml);
          var clientLead = $("<td>").html(avatarDiv).addClass("type-user-nameWithAvatar");

          var programsActiveAndTotal = $("<td>").text(thisOrg.ProgramsActiveAndTotal).addClass("type-qty-lg");
          var participantsActiveAndTotal = $("<td>").text(thisOrg.ParticipantsActiveAndTotal).addClass("type-qty-lg");
          var totalSubscriptions = $("<td>").text(thisOrg.TotalSubscriptions).addClass("type-qty-lg");
          var onboardingScore = $("<td>").text(thisOrg.OnboardingScore).addClass("type-qty-lg");

          var deliveryRevenueHtml = $("<td>").html(thisOrg.TotalDeliveryRevenueHtml).addClass("type-revenueprogress");

          var totalDealsOutstanding = $("<td>").text(thisOrg.TotalDealsOutstanding).addClass("type-money-lg");
          var totalDealsWon = $("<td>").text(thisOrg.TotalDealsWon).addClass("type-money-lg");

          row.append(companyName, clientLead, programsActiveAndTotal, participantsActiveAndTotal, totalSubscriptions, onboardingScore, deliveryRevenueHtml, totalDealsOutstanding, totalDealsWon);

          $orgListBody.append(row);
        }
        common_UpdateUI($orgListBody);
      }

    })(jQuery);
  </script>

}
