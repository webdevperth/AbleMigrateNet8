<form id="form1" method="post" action="#">
  <input type="hidden" name="@PathHelper.FormKeys.AjaxAction" value="update" />
  <input type="hidden" name="divCodeId" value="update" />
  <input type="hidden" name="accessList" value="" />
  <input type="hidden" name="sendList" value="" />
  <table class="table table-hover width-auto tblPartList">
    <thead>
      <tr>
        <th>Email Address</th>
        <th>Access<br/>Comments</th>
        <th>Send Email</th>
        <th>Test Report Link</th>
        <th>Email Last Sent</th>
      </tr>
    </thead>
    <tbody id="listBody">
    </tbody>
  </table>
</form>

<div class="content-fixed-footer">
  <hr class="hr-thin">
  <button class="btn btn-primary btnUpdate">Update</button>
</div>

@section PostScriptContent {

  <script type="text/javascript">
    (function($) {

      var selOrgLevel, btnUpdate, form1;

      $(document).ready(function () {

        selOrgLevel = $(".selOrgLevel");
        btnUpdate = $(".btnUpdate");
        form1 = $("#form1");

        selOrgLevel.change(function (e) { GetPartList(); });

        btnUpdate.click(DoUpdate);

        GetPartList();

      }); // ready

      function GetPartList() {

        selOrgLevel.blur(); // prevents mistakes using keyboard if select list remains in focus.

        var divCode = selOrgLevel.val();
        var url = document.location.href.replace(/\?.*/, "") + "?@Integral.Web.PortalSite.Pages_Albert.IOSParticipants.divCodeQueryParam=" + divCode;
        $.post(document.location.href, { "@Integral.Web.PortalSite.Pages_Albert.IOSParticipants.divCodeQueryParam": divCode })
        .done(function (e, f) {

          $("#listBody").html(e);

          common_ApplyUIAddons();
          UpdateButtonText();

          $(".colSend input").change(function (e) { UpdateButtonText() });

          $(".rowPart").click(function (e) {
            //var inp = $(this).find(".colAccess input");
            //var uid = inp.val();
            //inp[0].checked = !inp[0].checked;
          });


        });

      }

      function UpdateButtonText() {
        var checkCount = $(".colSend input:checked").length;
        var buttonText = "Update Access";
        if (checkCount > 0) buttonText += " and Send " + checkCount + " Email";
        if (checkCount > 1) buttonText += "s";
        btnUpdate.text(buttonText);
      }

      function DoUpdate() {

        form1[0]["divCodeId"].value = selOrgLevel.val();

        AjaxSubmit({
          form: form1,
          onSuccess: GetPartList
        });

      }

    })(jQuery);
  </script>

}
