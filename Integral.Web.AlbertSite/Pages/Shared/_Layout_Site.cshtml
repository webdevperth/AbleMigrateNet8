    @* Start error logging before loading Able scripts *@
    <script>

      var app_jsErrorOccurred = false;

      window.addEventListener('error', function (errorEvent) {

        var errorMessage = errorEvent.message;
        var errorUrl = errorEvent.filename;
        var errorLine = errorEvent.lineno;
        var errorColumn = errorEvent.colno;
        var errorObject = errorEvent.error;

        if (typeof errorMessage === "string") {
          // Ignore these error messages (each item can be a regex, case-insensitive):
          var arrIgnoreErrorRegex = [
            "ResizeObserver",
            "CredentialsContainer",
            "\"Pong\" is not valid"
          ];
          for (i in arrIgnoreErrorRegex) {
            var regexIgnoreErrors = new RegExp(arrIgnoreErrorRegex[i], "gi");
            if (regexIgnoreErrors.test(errorMessage)) return;
          }
        }

        // Ignore errors occurring in extensions.
        if (typeof errorUrl === "string") {
          if (errorUrl.match(/extension:\/\//gi)) return; // url contains "extension://"
        }

        app_jsErrorOccurred = true;

        var stackTrace = null;
        try {
          stackTrace = errorObject.stack; // Not all browsers implement this, ignore if not.
        } catch { }

        let referrerUrl = "@Html.Raw((SystemWeb.GetRequestHeader(AppHelper.HttpHeaders.Referrer) ?? "").JavaScriptEncode())";
        if (isStringNullOrEmpty(referrerUrl)) referrerUrl = document.referrer || "";

        try {
          $.post("@PathHelper.Endpoints.JSLogger()", {
            "@PathHelper.JSLoggerKeys.RequestUrl": encodeURIComponent(document.location.href),
            "@PathHelper.JSLoggerKeys.RequestQuery": encodeURIComponent(document.location.search),
            "@PathHelper.JSLoggerKeys.ReferrerUrl": encodeURIComponent(referrerUrl),
            "@PathHelper.JSLoggerKeys.BrowserUserAgent": encodeURIComponent(window.navigator.userAgent),
            "@PathHelper.JSLoggerKeys.ErrorMessage": encodeURIComponent(errorMessage),
            "@PathHelper.JSLoggerKeys.ErrorUrl": encodeURIComponent(errorUrl), // Could be different to request, e.g. external js file.
            "@PathHelper.JSLoggerKeys.ErrorLine": errorLine,
            "@PathHelper.JSLoggerKeys.ErrorColumn": errorColumn,
            "@PathHelper.JSLoggerKeys.StackTrace": encodeURIComponent(stackTrace)
          });
        } catch (e) {
          // Ignore
          if (app_isDev) {
            console.log("Error posting this error:");
            console.log(e);
          }
        }

        if (app_isDev) {
          console.log("Error  : " + errorMessage + "<br>"
            + "URL  : " + errorUrl + "<br>"
            + "Line : " + errorLine + "<br>"
            + "<pre>" + stackTrace + "</pre>");
        }

        if (typeof BootstrapDialog === 'undefined') {

          alert(
            "Unfortunately an error occurred on this page.\n\n" +
            "We apologise for the interruption, we have been alerted and it will be resolved as soon as possible. " +
            "In the meantime, it may help to go back to the previous page and try again.");

        } else {

          BootstrapDialog.show({
            title: 'Oops!',
            message: "Unfortunately an error occurred on this page.<br/><br/>" +
              "We apologise for the interruption, we have been alerted and it will be resolved as soon as possible. " +
              "In the meantime, it may help to go back to the previous page and try again.",
            type: BootstrapDialog.TYPE_WARNING,
            closable: true,
            animate: false,
            draggable: true,
            buttons: [
              {
                label: "Ok",
                cssClass: 'btn-primary',
                hotkey: 13,
                action: function (dialog) { dialog.close(); }
              }
            ],
            onshown: function (dialog) {
              var modal = dialog.getModalDialog();
              var top = ($(window).height() - modal.height()) / 2 - 20;
              if (top > 0) modal.css("margin-top", top + "px");
              setTimeout(function () { modal.find(".btn-primary").focus(); }, 200);
            },
            onhidden: function (dialogRef) {
              if (app_isDev) {
                alert(errorMessage + '\n' + errorUrl + '\n' + 'line: ' + errorLine);
              }
            }
          });

        }

        return false; // true prevents firing of default event handler.
      });

    </script>

    @await RenderSectionAsync("HeadContentBeforeCustomScripts", required: false)

