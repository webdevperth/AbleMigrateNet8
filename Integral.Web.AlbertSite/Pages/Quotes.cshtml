@page
@model Integral.Web.PortalSite.Pages_Albert.Quotes
@{ Layout = "_Layout_AdminLTE"; }

@if (!Model.UserHasAnyQuotes) {

  @Html.Raw(Model.GetEmptyStateHtml())

} else {

  <div class="content-action-bar">
    <div class="left">
      @if (Model.CanViewQuoteListActiveToggle) {
        <div class="status-toggle input-group" id="btnGrpActive" data-toggle="buttons">
          <label class="btn @(Model.searchInfo.StatusClosed ? "" : "active")"><input type="radio" name="toggleActive" value="@PathHelper.AbleUrlValues.QuoteStatusToggleValue_Active" @(Model.searchInfo.StatusClosed ? "" : "checked") />Active</label>
          <label class="btn @(Model.searchInfo.StatusClosed ? "active" : "")"><input type="radio" name="toggleActive" value="@PathHelper.AbleUrlValues.QuoteStatusToggleValue_Closed" @(Model.searchInfo.StatusClosed ? "checked" : "") />Completed</label>
        </div>
      }
      <div class="search-input">
        <i class="fa fa-search"></i>
        <input type="text" id="txtSearch" name="@PathHelper.AbleUrlKeys.JobSearchTerm" value="" placeholder="Search job number, name..." autofocus="autofocus">
      </div>
    </div>
    <div class="right">
      @if (Model.CanCreateQuote) {
        <a class="btn btn-primary floatright ml10" href="@Html.Raw(PathHelper.Pages.QuoteCreate())">New Quote</a>
      }
      @if (Model.CanRequestQuote) {
        @Html.Raw(Model.GetRequestQuoteButtonHtml())
      }
    </div>
  </div>

  <input type="hidden" id="inpGetPage" value="1" />

  <div class="table-responsive">
    <table class="table table-bordered table-hover table-rowlink limit-width" data-rowlink-url="">
      <thead>
        <tr>
          <th class="type-project-name">Project</th>
          <th class="type-user-nameWithAvatar">Deal Owner</th>
          <th class="type-date">Created</th>
          <th class="type-status">Status</th>
          <th class="type-qty">Items</th>
          <th class="type-money">Total ex-GST</th>
        </tr>
        <tr class="displaynone rowData" id="rowTemplate" tabindex="0">
          <td class="rowDataCell type-project-name" data-fieldname="JobTitle"></td>
          <td class="rowDataCell type-user-nameWithAvatar" data-fieldname="DealOwner"></td>
          <td class="rowDataCell type-date" data-fieldname="CreatedUtc" data-isutcdate="true" data-format="D MMM YYYY"></td>
          <td class="rowDataCell type-status" data-fieldname="StatusText"></td>
          <td class="rowDataCell type-qty" data-fieldname="QuoteItemCount"></td>
          <td class="rowDataCell type-money" data-fieldname="QuoteItemTotalAmount" data-format="currency"></td>
        </tr>
      </thead>
      <tbody id="tblQuotesBody">
      </tbody>
    </table>
  </div>

  <div class="table-bottom">
    <div class="left">
      <span class="badge found-badge"><span class="pagination-total"></span>&nbsp; results</span>
    </div>
    <div class="right">
      <div class="pagination">
        <div class="pagination-page">Page: <div class="pagination-pagebuttons"><div class="pagination-pagebutton">1</div></div></div>
      </div>
    </div>
  </div>

}

@section PostScriptContent {

  <script type="text/javascript">
    (function($) {

      var inpGetPage;
      var rowTemplate, tblQuotesBody, txtSearch;
      var paginationPageButtons, paginationPageButton, paginationSection;
      var keyTimeout = null;
      var currentSearchValue, currentActiveToggleValue, currentPage;

      $(document).ready(function() {

        currentSearchValue = "";
        currentActiveToggleValue = "";
        currentPage = 0;

        btnGrpActive = $("#btnGrpActive");
        txtSearch = $("#txtSearch");
        inpGetPage = $("#inpGetPage");
        paginationSection = $(".pagination");
        paginationPageButtons = $(".pagination-pagebuttons");
        paginationPageButton = $(".pagination-pagebutton");
        paginationPageButton.detach();
        rowTemplate = $("#rowTemplate");
        rowTemplate.detach().removeAttr("id").removeClass("displaynone");
        tblQuotesBody = $("#tblQuotesBody");

        SetActiveToggleValue(@Html.Raw(SessionHelper.AppState.Quotes.Search_StatusClosed.ToJSTrueFalse()));
        txtSearch.val("@(SessionHelper.AppState.Quotes.Search_SearchFor ?? string.Empty)");
        inpGetPage.val("@(SessionHelper.AppState.Quotes.Search_CurrentPage ?? 1)");

        btnGrpActive.on("change", "input:checked", ActiveToggled);
        txtSearch.keyup(SearchKeyUp);
        paginationPageButtons.click(GoToResultsPage);

        SearchKeyTimeout(txtSearch, true); // Get initial results.

        @if (!Model.CanRoleViewQuotes) {
          <text>
          $('.table').data('@WebHelper.DataAttrName.RowLinkNewTab', true);
          </text>
        }

        @if (Model.CanRequestQuote) {
          <text>
          $("#btnRequestQuote").click(ShowQuoteRequestModal)
          </text>
        }

      }); // ready.

      function ShowQuoteRequestModal() {

        BootstrapDialog.show({
          title: "Request Quote",
          onshow: function (dialogRef) {
            var modalDialog = dialogRef.getModalDialog();
            modalDialog.css("width", "780px");
            modalDialog.data("@WebHelper.DataAttrName.DialogRef", dialogRef);
            var modalBody = dialogRef.getModalBody();
            modalBody.busyLoad("show");
            modalBody.load('@Html.Raw(PathHelper.Partials.QuoteRequestModal(""))',
                function (data) {
                  modalBody.html(data);
                  modalBody.busyLoad("hide");
                  common_UpdateUI(modalBody);
                }
              );
            }
          });
      }

      function GetActiveToggleValue() {
        $checked = btnGrpActive.find("input:checked");
        if ($checked.length != 1) return "";
        return $checked.val();
      }

      function SetActiveToggleValue(statusClosed) {
        var btn;
        if (statusClosed === true) {
          btn = btnGrpActive.find('input[value="@PathHelper.AbleUrlValues.QuoteStatusToggleValue_Closed"]');
        } else {
          btn = btnGrpActive.find('input[value="@PathHelper.AbleUrlValues.QuoteStatusToggleValue_Active"]');
        }
        if (btn.length === 1) {
          //btn.prop("checked", true);
          btn.trigger("click");
        }
      }

      function ActiveToggled(evt) {
        SearchKeyTimeout(txtSearch, true);
      }

      function GoToResultsPage(ev) {
        var $btn = $(ev.target);
        if (!$btn.hasClass("pagination-pagebutton")) return;
        var page = $btn.text();
        inpGetPage.val(page);
        SearchKeyTimeout(txtSearch, true);
      }

      function SearchKeyUp(ev, data) {
        var isImmediate = (data && data.immediate);
        var $inp = $(ev.target);
        if (keyTimeout) clearTimeout(keyTimeout);
        if (isImmediate) SearchKeyTimeout($inp, isImmediate);
        else keyTimeout = setTimeout(function () { keyTimeout = null; SearchKeyTimeout($inp, isImmediate); }, 800);
      }

      function SearchKeyTimeout($inp, isImmediate) {

        var newSearchValue = $inp.val() || '';
        var newActiveToggleValue = GetActiveToggleValue();
        var newPage = parseInt(inpGetPage.val(), 10);
        var minLength = @Integral.Web.PortalSite.Pages_Albert.Quotes.Min_Search_Length;
        if (isNaN(newPage)) newPage = 1;

        if (newSearchValue === currentSearchValue
          && newActiveToggleValue === currentActiveToggleValue
          && newPage === currentPage
          && isImmediate !== true) return;

        if (newSearchValue.length > 0 && newSearchValue.length < minLength) {
          return; // newSearchValue too short.
        }

        if (newSearchValue !== currentSearchValue
          || newActiveToggleValue !== currentActiveToggleValue) newPage = 1; // new search, default to page 1

        currentSearchValue = newSearchValue;
        currentActiveToggleValue = newActiveToggleValue;
        currentPage = newPage;

        tblQuotesBody.empty();
        $.busyLoadFull("show");

        $.get(location.pathname,
          {
            "@PathHelper.AbleUrlKeys.QuotesSearchTerm": encodeURIComponent(newSearchValue),
            "@PathHelper.AbleUrlKeys.QuoteStatusToggle": encodeURIComponent(GetActiveToggleValue()),
            "@PathHelper.AbleUrlKeys.GetPage": newPage
          },
          function (data, status, jqXHR) { PopulateTableBody(data); },
          "json")
          .fail(function () { alert("Oops, there was a problem!"); })
          .always(function () { $.busyLoadFull("hide"); });
      }

      function PopulateTableBody(json) {

        tblQuotesBody.empty();

        if (!json) return;

        var offsetRows = json.OffsetRows;
        var rowsPerPage = json.FetchRows;
        var totalRows = json.TotalRows;
        var currentPage = Math.floor(offsetRows / rowsPerPage) + 1;
        var totalPages = Math.ceil(totalRows / rowsPerPage);

        $(".pagination-total").text(totalRows);
        paginationPageButtons.empty();

        if (rowsPerPage != null) {
          for (var page = 1; page <= totalPages; page++) {
            var newButton = paginationPageButton.clone();
            newButton.text(page);
            if (page == currentPage) newButton.addClass("current");
            paginationPageButtons.append(newButton);
          }
        }

        // Hide Pagination section if there's no results to prevent showing 'Page' text.
        if (totalRows == 0) {
          paginationSection.hide();
        } else {
          paginationSection.show();
        }

        var rowList = json.InfoList;
        if (!rowList) return;
        for(var rowNum in rowList) {
          var rowData = rowList[rowNum];
          var trRow = rowTemplate.clone();
          trRow.attr("data-rowlink-url", rowData.QuoteUrl);
          trRow.find(".rowDataCell").each(function(i, e) {
            var cell = $(e);
            var fieldName = "" + cell.data("fieldname");
            var value;
            if (fieldName == "JobTitle") {
              cell.html(rowData.ProjectName);
            } if (fieldName == "StatusText") {
              var mdate = moment(rowData.ClientAcceptedUtc);
              cell.html(
                rowData.StatusText
                + (!mdate.isValid() ? "" : "<p class=\"statusDate\">" + mdate.format("D MMM YYYY") + "</p>"));
            } else if (fieldName == "DealOwner") {
              cell.html(rowData.DealOwner);
            } else if (fieldName == "QuoteViewIcon") {
              cell.html(rowData.QuoteViewIcon);
            } else if (rowData[fieldName] != 'undefined') {
              value = rowData[fieldName];
              var isUtcDate = (cell.data("isutcdate") === true);
              var format = "" + cell.data("format");
              if (value === null || value === "") {
                cell.html("");
              } else {
                if (isUtcDate) {
                  if (format == "") format = "D MMM YYYY";
                  cell.text(moment(value).format(format));
                } else if (format == "$" || format == "currency") {
                  cell.text(CurrencyFormatter.format(value));
                } else {
                  cell.text(value);
                }
              }
            }
          });
          tblQuotesBody.append(trRow);
        }
      }

    })(jQuery);
  </script>

}
