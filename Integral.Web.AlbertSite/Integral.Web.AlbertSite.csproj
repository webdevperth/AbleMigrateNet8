<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Integral.Web.PortalSite</RootNamespace>
    <AssemblyName>Integral.Web.PortalSite</AssemblyName>
    <UserSecretsId>integral-able-portalsite</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Integral.Web.App\Integral.Web.App.csproj" />
    <ProjectReference Include="..\Integral.Web.Data\Integral.Web.DAL.csproj" />
    <ProjectReference Include="..\Integral.Web.WebHelpers\Integral.Web.WebHelpers.csproj" />
    <ProjectReference Include="..\Integral.Integrations\Integral.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="Mandrill.net" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Select.HtmlToPdf.NetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="templates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    AppCode/ holds helpers carried over from the .NET Framework build. A few of those
    files (e.g. Reports.PDF.cs, EvalViewerPartialBase.cs) are not yet wired into the
    Razor pages, so the directory is excluded by default and the active helpers are
    re-included individually below. Program.cs invokes the bootstrap classes on start.
  -->
  <ItemGroup>
    <Compile Remove="AppCode\**\*.cs" />
    <Compile Include="AppCode\ApplicationInsightsBootstrap.cs" />
    <Compile Include="AppCode\IntercomBootstrap.cs" />
    <Compile Include="AppCode\IntercomHelpers.cs" />
    <Compile Include="AppCode\AmplitudeBootstrap.cs" />
    <Compile Include="AppCode\AmplitudeHelper.cs" />
    <Compile Include="AppCode\AuthInitialization.cs" />
    <Compile Include="AppCode\LayoutModel.cs" />
    <Compile Include="AppCode\OrgReportContext.cs" />
    <Compile Include="AppCode\Coachee360Context.cs" />
    <Compile Include="AppCode\Reports.OrgReports.cs" />
    <Compile Include="AppCode\ReportHelper.Coachee.cs" />
    <Compile Include="AppCode\PageBaseClasses\LoggedInPageModel.cs" />
    <Compile Include="AppCode\PageBaseClasses\CoacheeInfoBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\CoachInfoBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\CompanyInfoBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\OverviewPageBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\ProjectPageBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\ProgramPageBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\QuotePageBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\ModulePageBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\SettingsPageBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\CoacheeReportPartialBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\CompanyReportPartialBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\SkillsViewerPartialBase.cs" />
    <Compile Include="AppCode\PageBaseClasses\SurveyViewerPartialBase.cs" />
    <Compile Include="AppCode\ReportHelper.HeatMap.cs" />
    <Compile Include="AppCode\StripeHelper.cs" />
    <Compile Include="AppCode\ApplicationInsightsExtensions.cs" />
    <Compile Include="AppCode\IntercomEventBuilderExtensions.cs" />
  </ItemGroup>

</Project>
