        <% if (SessionHelper.IsUserLoggedIn) { %>
        appInsights.setAuthenticatedUserContext("<%= SessionHelper.AsExternalUserId().ToString() %>");
        <% } %>

        // Add environment to all telemetry
        appInsights.addTelemetryInitializer(function(envelope) {
          envelope.baseData = envelope.baseData || {};
          envelope.baseData.properties = envelope.baseData.properties || {};
          envelope.baseData.properties["Environment"] = "<%= ConfigHelper.EnvironmentType %>";
        });
      </script>
