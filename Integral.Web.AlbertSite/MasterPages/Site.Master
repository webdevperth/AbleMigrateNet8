      const JS_DataAttrName_SlideoutCallbackFunction = "<%= WebHelper.DataAttrName.SlideoutCallbackFunction %>";
      const JS_DataAttrName_ModalPartialUrl = "<%= WebHelper.DataAttrName.ModalPartialUrl %>";
