    <%-- Start error logging before loading Able scripts --%>
    <script>

      var app_jsErrorOccurred = false;

      window.addEventListener('error', function (errorEvent) {

        var errorMessage = errorEvent.message;
        var errorUrl = errorEvent.filename;
        var errorLine = errorEvent.lineno;
        var errorColumn = errorEvent.colno;
        var errorObject = errorEvent.error;

        if (typeof errorMessage === "string") {
          // Ignore these error messages (each item can be a regex, case-insensitive):
          var arrIgnoreErrorRegex = [
            "ResizeObserver",
            "CredentialsContainer",
            "\"Pong\" is not valid"
          ];
          for (i in arrIgnoreErrorRegex) {
            var regexIgnoreErrors = new RegExp(arrIgnoreErrorRegex[i], "gi");
            if (regexIgnoreErrors.test(errorMessage)) return;
          }
        }

        // Ignore errors occurring in extensions.
        if (typeof errorUrl === "string") {
          if (errorUrl.match(/extension:\/\//gi)) return; // url contains "extension://"
        }

        app_jsErrorOccurred = true;

        var stackTrace = null;
        try {
          stackTrace = errorObject.stack; // Not all browsers implement this, ignore if not.
        } catch { }

        let referrerUrl = "<%= (Request.Headers[AppHelper.HttpHeaders.Referrer] ?? "").JavaScriptEncode() %>";
        if (isStringNullOrEmpty(referrerUrl)) referrerUrl = document.referrer || "";

        try {
          $.post("<%= PathHelper.Endpoints.JSLogger() %>", {
            "<%= PathHelper.JSLoggerKeys.RequestUrl %>": encodeURIComponent(document.location.href),
            "<%= PathHelper.JSLoggerKeys.RequestQuery %>": encodeURIComponent(document.location.search),
            "<%= PathHelper.JSLoggerKeys.ReferrerUrl %>": encodeURIComponent(referrerUrl),
            "<%= PathHelper.JSLoggerKeys.BrowserUserAgent %>": encodeURIComponent(window.navigator.userAgent),
            "<%= PathHelper.JSLoggerKeys.ErrorMessage %>": encodeURIComponent(errorMessage),
            "<%= PathHelper.JSLoggerKeys.ErrorUrl %>": encodeURIComponent(errorUrl), // Could be different to request, e.g. external js file.
            "<%= PathHelper.JSLoggerKeys.ErrorLine %>": errorLine,
            "<%= PathHelper.JSLoggerKeys.ErrorColumn %>": errorColumn,
            "<%= PathHelper.JSLoggerKeys.StackTrace %>": encodeURIComponent(stackTrace)
          });
        } catch (e) {
          // Ignore
          if (app_isDev) {
            console.log("Error posting this error:");
            console.log(e);
          }
        }

        if (app_isDev) {
          console.log("Error  : " + errorMessage + "<br>"
            + "URL  : " + errorUrl + "<br>"
            + "Line : " + errorLine + "<br>"
            + "<pre>" + stackTrace + "</pre>");
        }

        if (typeof BootstrapDialog === 'undefined') {

          alert(
            "Unfortunately an error occurred on this page.\n\n" +
            "We apologise for the interruption, we have been alerted and it will be resolved as soon as possible. " +
            "In the meantime, it may help to go back to the previous page and try again.");

        } else {

          BootstrapDialog.show({
            title: 'Oops!',
            message: "Unfortunately an error occurred on this page.<br/><br/>" +
              "We apologise for the interruption, we have been alerted and it will be resolved as soon as possible. " +
              "In the meantime, it may help to go back to the previous page and try again.",
            type: BootstrapDialog.TYPE_WARNING,
            closable: true,
            animate: false,
            draggable: true,
            buttons: [
              {
                label: "Ok",
                cssClass: 'btn-primary',
                hotkey: 13,
                action: function (dialog) { dialog.close(); }
              }
            ],
            onshown: function (dialog) {
              var modal = dialog.getModalDialog();
              var top = ($(window).height() - modal.height()) / 2 - 20;
              if (top > 0) modal.css("margin-top", top + "px");
              setTimeout(function () { modal.find(".btn-primary").focus(); }, 200);
            },
            onhidden: function (dialogRef) {
              if (app_isDev) {
                alert(errorMessage + '\n' + errorUrl + '\n' + 'line: ' + errorLine);
              }
            }
          });

        }

        return false; // true prevents firing of default event handler.
      });

    </script>

    <asp:ContentPlaceHolder ID="HeadContentBeforeCustomScripts" runat="server" />

    <%-- Able custom scripts load last, and must be after the JS consts above. --%>
    <script src="<%= PathHelper.UrlPath.JS %>common-functions.js?v=<%= PathHelper.ScriptVer %>" type="text/javascript"></script>
    <script src="<%= PathHelper.UrlPath.JS %>bootstrap-functions.js?v=<%= PathHelper.ScriptVer %>" type="text/javascript"></script>
    <script src="<%= PathHelper.UrlPath.JS %>CommonDialogs.js?v=<%= PathHelper.ScriptVer %>" type="text/javascript"></script>
    <script src="<%= PathHelper.UrlPath.JS %>AjaxSubmit.js?v=<%= PathHelper.ScriptVer %>" type="text/javascript"></script>

    <%-- Show page messages on load --%>

    <script>

      <% if (!Layout.PageMessageText.IsNullOrEmpty()) { %>
        $(window).on('load', function () { <%-- wait for fully parsed CSS as we are showing something immediately on page load --%>

          <% if (Layout.PageMessageType == AjaxSubmitHelper.PageMessageType.InfoToast) { %>

            common_InfoToast("<%= Layout.PageMessageText %>");

          <% } else if (Layout.PageMessageType == AjaxSubmitHelper.PageMessageType.SuccessToast) { %>

            common_SuccessToast("<%= Layout.PageMessageText %>");

          <% } else if (Layout.PageMessageType == AjaxSubmitHelper.PageMessageType.ErrorToast) { %>

            common_ErrorToast("<%= Layout.PageMessageText %>");

          <% } else { %>

            BootstrapDialog.show({
              title: "", cssClass: "no-title",
              message: "<%= Layout.PageMessageText.Replace("\"", "&quot;") %>",
              type: BootstrapDialog.<%= WebHelper.GetNextPageMessageTypeForBootstrapDialog() %>,
              closable: true, animate: false, draggable: true,
              buttons: [{ label: "Ok", cssClass: 'btn-primary', hotkey: 13, action: function (dialog) { dialog.close(); } }],
              onshown: function (dialog) {
                var modal = dialog.getModalDialog();
                var top = ($(window).height() - modal.height()) / 2 - 20;
                if (top > 0) modal.css("margin-top", top + "px");
                setTimeout(function () { modal.find(".btn-primary").focus(); }, 200); // timeout required.
              },
            });

          <% } %>
        });
      <% } %>

      <% if (SessionHelper.IsUserLoggedIn) { %>
        $(document).ready(function () {
          setInterval(function () { $.get("<%= PathHelper.Endpoints.JSLogger() %>"); }, 600000); <%-- keep-alive --%>
        });
      <% } %>

      if (Tabulator) {
        Tabulator.defaultOptions.ajaxURL = document.location.href;
        Tabulator.defaultOptions.ajaxContentType = "form";
        Tabulator.defaultOptions.ajaxParams = {
          '<%= PathHelper.FormKeys.AjaxAction %>': '<%= WebHelper.Tabulator.AjaxAction.GetTableData.ToString() %>'
        };
        Tabulator.defaultOptions.ajaxConfig = {
          method: "POST",
          headers: {
            "<%= AppHelper.HttpHeaders.IsAjax %>": true,
            "<%= AppHelper.HttpHeaders.IsTabulator %>": true
          }
        };
      }

    </script>

    <%-- extra HEAD content defined on pages --%>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <%-- Hotjar, Google etc at very end of HEAD, only load on production --%>
    <% if (ConfigHelper.IsLiveServer) { %>

      <script>
        (function (h, o, t, j, a, r) {
          h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments) };
          h._hjSettings = { hjid: 2880253, hjsv: 6 };
          a = o.getElementsByTagName('head')[0];
          r = o.createElement('script'); r.async = 1;
          r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
          a.appendChild(r);
        })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
      </script>

      <script async src="https://www.googletagmanager.com/gtag/js?id=G-7FFK7QN4ER"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-7FFK7QN4ER');
        gtag('set', { 'user_type': "<%= GetTrackingUserRoleName() %>" });
      </script>

    <% } %>

  </head>

  <body class="fixed hold-transition <%= Layout.BodyClass %>">

    <asp:ContentPlaceHolder ID="BodyContent" runat="server" />

    <div id="siteModalTemplate" class="modal fade" tabindex="-1" role="dialog">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <h4 class="modal-title">Modal title</h4>
          </div>
          <div class="modal-body"></div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary">Save changes</button>
          </div>
        </div>
      </div>
    </div>

    <asp:ContentPlaceHolder ID="PostScriptContent" runat="server" />

    <% if (SessionHelper.CanShowDebugMessages) { %>
      <script>

        if (app_canShowDebugMessages && typeof screenLog === "object") {
          // Set up screenLog and show messages from server.
          try {
            screenLog.init({ startTop: 250 });
            $('.chinchang-screenLog').draggable({ cancel: '.chinchang-screenLog-rows' });
          } catch (e) {
            console.log("screenLog error:");
            console.log(e);
          }
        }

        <%= LogHelper.GetResponseLogJS() %>

      </script>
    <% } %>

    <%-- Fonts --%>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wdth,wght@0,97,300..800;1,97,300..800&display=swap" rel="stylesheet">

    <% if (SessionHelper.IsUserLoggedIn) { %>
      <script>
        window.intercomSettings = {
          api_base: "https://api-iam.intercom.io",
          app_id: "yunr84s6",
          intercom_user_jwt: "<%= Integral.Web.PortalSite.AppCode.IntercomHelpers.CreateUserJwt(SessionHelper.GetUserInfoOrNull()) %>"
        };
      </script>
    <% } %>

    <script>
      (function () { var w = window; var ic = w.Intercom; if (typeof ic === "function") { ic('reattach_activator'); ic('update', w.intercomSettings); } else { var d = document; var i = function () { i.c(arguments); }; i.q = []; i.c = function (args) { i.q.push(args); }; w.Intercom = i; var l = function () { var s = d.createElement('script'); s.type = 'text/javascript'; s.async = true; s.src = 'https://widget.intercom.io/widget/yunr84s6'; var x = d.getElementsByTagName('script')[0]; x.parentNode.insertBefore(s, x); }; if (document.readyState === 'complete') { l(); } else if (w.attachEvent) { w.attachEvent('onload', l); } else { w.addEventListener('load', l, false); } } })();
    </script>

  </body>
</html>
