      const DATEPICKER_OUTPUT_FORMAT_JS = "<%= WebHelper.DATE_OUTPUT_FORMAT_JS %>";
      const DATEPICKER_OUTPUT_FORMAT_MOMENTJS = "<%= WebHelper.DATE_OUTPUT_FORMAT_MOMENTJS %>";
      const JS_ElementID_SlideoutBackdrop = "<%= WebHelper.ElementID.SlideoutBackdrop %>";
      const JS_ElementID_SlideoutPanelHeader = "<%= WebHelper.ElementID.SlideoutPanelHeader %>";
