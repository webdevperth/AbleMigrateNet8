    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.8.0/js/bootstrap-datepicker.min.js" type="text/javascript"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.8.0/css/bootstrap-datepicker.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.full.min.js" type="text/javascript"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" />

    <script src="https://cdn.jsdelivr.net/gh/StephanWagner/jBox@v1.3.2/dist/jBox.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/StephanWagner/jBox@v1.3.2/dist/jBox.all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/busy-load/dist/app.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/busy-load/dist/app.min.css" />

    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css" rel="stylesheet">
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@3.7.2/build/global/luxon.min.js"></script>

    <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="<%= PathHelper.UrlPath.JS %>FA5PRO-5.7.2/css/all.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/iCheck/1.0.2/icheck.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.7.3/Chart.bundle.min.js" type="text/javascript"></script>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/smartwizard@6/dist/js/jquery.smartWizard.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/smartwizard@6/dist/css/smart_wizard_all.min.css" />

    <%-- Able styles --%>
    <link rel="stylesheet" href="<%= PathHelper.UrlPath.CSS %>portal-site.css?v=<%= PathHelper.ScriptVer %>" />
    <link rel="stylesheet" href="<%= PathHelper.UrlPath.CSS %>adminlte-custom-2022.css?v=<%= PathHelper.ScriptVer %>" />
    <link rel="stylesheet" href="<%= PathHelper.UrlPath.CSS %>tabulator-able.css?v=<%= PathHelper.ScriptVer %>" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.23.0/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.23.0/locale/en-au.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/big.js@6.0.0/big.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/js-cookie/2.2.1/js.cookie.min.js"></script>

    <% if (ShouldLoadAmplitude()) { %>

      <script src="https://cdn.amplitude.com/libs/analytics-browser-2.25.4-min.js.gz"></script>

      <% if (IsAmplitudeSessionReplayEnabled()) { %>
        <script src="https://cdn.amplitude.com/libs/plugin-session-replay-browser-1.22.2-min.js.gz"></script>
      <% } %>

      <script>

        <% if (IsAmplitudeSessionReplayEnabled()) { %>
          // Session replay enabled for configured user roles: <%= ConfigHelper.Amplitude.SessionReplayAllowedRoles %>
          const sessionReplayTracking = window.sessionReplay.plugin({
            forceSessionTracking: true, // Enable capture of Session Start and Session End events
            sampleRate: <%= ConfigHelper.Amplitude.SessionReplaySampleRate %>,
          });
          window.amplitude.add(sessionReplayTracking);
        <% } %>

        window.amplitude.init('<%= ConfigHelper.Amplitude.ApiKey %>', {
          userId: '<%= AmplitudeHelper.GetCurrentExternalUserId()?.ToString() %>',
          deviceId: '<%= AmplitudeHelper.GetCurrentAmplitudeDevice() %>',
          defaultTracking: true,
          sampleRate: <%= ConfigHelper.Amplitude.AnalyticsSampleRate %>,
        });

        // Set user properties via frontend identify call (complements backend Identify API)
        <%= GetAmplitudeIdentifyScript() %>

      </script>
    <% } %>

    <% if (ConfigHelper.ShowScreenLog) { %>
      <script src="<%= PathHelper.UrlPath.JS %>screenlog-modded.js" type="text/javascript"></script>
      <script>
        (function ($) {
          $(document).ready(function () {
            screenLog.init({ startTop: 85 });
          });
        })(jQuery);
      </script>
    <% } %>

    <script>
      <%-- busyLoad defaults --%>
      $(document).ready(function () {
        if ($.busyLoadSetup) {
          $.busyLoadSetup({
            background: "rgb(255, 255, 255, 0.4)",
            image: "<%= PathHelper.Images.BusyLoadSpinner200() %>",
            color: "#634CFF",
            maxSize: "70px",
            minSize: "70px"
          });
        }
      });
    </script>

    <%-- Consts used by Able scripts --%>
    <script>
      const app_scriptVer = "<%= PathHelper.ScriptVer %>";
      const app_isDev = <%= ConfigHelper.IsDevServer.ToJSTrueFalse() %>;
      const app_isStaging = <%= ConfigHelper.IsStagingServer.ToJSTrueFalse() %>;
      const app_isLive = <%= ConfigHelper.IsLiveServer.ToJSTrueFalse() %>;
      const app_canShowDebugMessages = <%= SessionHelper.CanShowDebugMessages.ToJSTrueFalse() %>;
      const app_ajaxPath = "<%= PathHelper.UrlPath.Ajax %>";
      const app_jsPath = "<%= PathHelper.UrlPath.JS %>";
      const app_cssPath = "<%= PathHelper.UrlPath.CSS %>";
