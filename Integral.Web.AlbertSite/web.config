<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
  Note the use of both web.config AND external config files:
    1. localconfig/connectionStrings.config
    2. localconfig/smtp.config
    3. localconfig/appSetings.config
    4. localconfig/sessionState.config

  The external config files contain API keys, connection strings & passwords.
  These files are in the /localconfig folder, which is added to .gitignore, so it is NOT added to the repo.
  ==================================================================================================
  Repeat: All API keys, passwords etc. go in the /localconfig files which are NOT added to the repo.
  ==================================================================================================

  For running locally with a public domain:
    1. Set up a Cloudflare tunnel with a subdomain of helloable.co or a personal domain.
    2. Add a "published application route" to the tunnel, which points to "https://locahost:<your local port>".
       - Then expand "Additional application settings", expand "TLS" under that, set "Origin Server Name" to "localhost".

  -->
  <!-- 1. External config for connection strings:  -->
  <connectionStrings configSource="localconfig\connectionStrings.config" />
  <!--
  localconfig\connectionStrings.config should contain the following:
  <connectionStrings>
    <add name="IntegralDb" connectionString="[connection string here]" providerName="Microsoft.Data.SqlClient; Connection Timeout=60" />
  </connectionStrings>
  -->
  <!-- 2. External config for SMTP settings:  -->
  <system.net>
    <mailSettings>
      <smtp configSource="localconfig\smtp.config" />
    </mailSettings>
  </system.net>
  <!--
  localconfig\smtp.config should contain the following:
  <smtp deliveryMethod="Network" from="coordination@integral.global">
    <network host="smtp.mandrillapp.com" port="587" enableSsl="false" userName="Integral Development" password="[API key here]" />
  </smtp>
  -->
  <!-- 3. External config for adding server-specific appSettings: -->
  <appSettings file="localconfig\appSettings.config">
    <add key="AdminTools_AllowedUsers" value="frasier@helloable.co,jonah@integral.global,jeroen@integral.global,cj@integral.global,andrew@integral.global,phil@integral.global" />
    <!-- Fix for IIS error  "The request queue limit of the session is exceeded." -->
    <!-- See: https://stackoverflow.com/questions/59938410/the-request-queue-limit-of-the-session-is-exceeded -->
    <add key="aspnet:RequestQueueLimitPerSession" value="2147483647" />
    <add key="aspnet:AllowConcurrentRequestsPerSession" value="true" />
    <add key="AmplitudeApiKey" value="" />
    <!--
    localconfig\appSettings.config should contain the following:
    <appSettings>

      // IMPORTANT:
      // This overrides ALL email recipient addresses, so no emails are accidentally sent to real users.
      // It is a required setting for dev and staging. Any email addr is ok, doesn't need to be an Able account.
      // Leave blank on production for normal operation.
      <add key="OverrideRecipientEmail" value="[Your Email Address Here]" />

      // Mandrill is used for sending emails & API queries for emails.
      <add key="MandrillAPIKey" value="[API key here]" />

      // SMTP for some legacy code. Likely same as Mandrill api key above, as Mandrill's SMTP server is used.
      <add key="SMTPAuthPassword" value="[API key here]" />

      // Various EventGrid endpoint keys.
      <add key="EventGridAccessKey" value="[API key here]" />
      <add key="EventGridAccessKey_Quotes" value="[API key here]" />
      <add key="EventGridAccessKey_Accounting" value="[API key here]" />

      // Stripe.
      <add key="StripeClientId" value="[public key used at front end]" />
      <add key="StripeApiKey" value="[private key used at back end]" />

      // Azure Application Insights for the production site. For dev/staging, omit or leave blank to disable.
      // Obtain from Azure portal under App Insights for app "integral-able-live"
      // Here: https://portal.azure.com/#@integral.global/resource/subscriptions/97064157-a633-42a5-8483-5ea438969988/resourceGroups/Integral-AusEast/providers/microsoft.insights/components/integral-able-live/overview
      <add key="ApplicationInsightsConnectionString" value="[connection string]" />

      // Tester accounts:
      <add key="TestUserAccounts" value="[List of app tester account email addresses]" />

      // Jarvis domain for the same environment (i.e. staging Jarvis if this is for staging Able).
      <add key="SiteDomain_Jarvis" value="https://[jarvis domain]" />

      // Test user account that Playwright will use during tests.
      <add key="PlaywrightTestAccount_UserId" value="[user ID]" />
      <add key="PlaywrightTestAccount_Email" value="[user email]" />
      <add key="PlaywrightTestAccount_Password" value="[user password]" />

    </appSettings>

    Add the following to localconfig/appSettings.config only on staging & integration servers:

    <add key="IsStaging" value="true" />
    <add key="UploadsFolderPath" value="[server path to mapped blob storage for uploads, e.g. Z:\storage\uploads]" />
    -->
    <!-- ==================================================================== -->
    <!-- These are overriden by above or on production by web.release.config. -->
    <!-- ==================================================================== -->
    <add key="IsLive" value="false" />
    <add key="IsStaging" value="false" />
    <add key="SiteDomain_Jarvis" value="https://integral-jarvis-staging.azurewebsites.net" />
    <add key="AbleAppDomain" value="" />
    <!-- Blank = gets domain automatically from request -->
    <add key="ParticipantAIChatEndpoint" value="" />
    <!-- ==================================================================== -->
    <!-- Below settings are usually the same for dev, staging and production. -->
    <!-- ==================================================================== -->
    <add key="LoginSessionTimeoutDays" value="90" />
    <!-- Note: Folder name must be same as used in StorageHandler rewrite rule -->
    <add key="UploadsFolderName" value="uploads" />
    <!-- Note: Folder name must be same as used in StorageHandler rewrite rule -->
    <add key="SMTPServer" value="smtp.mandrillapp.com" />
    <add key="SMTPPort" value="587" />
    <add key="SMTPUseSSL" value="false" />
    <add key="SMTPAuthUsername" value="Integral Development" />
    <add key="MandrillTemplate_CoacheeBookingReminder" value="book-your-next-coaching-session" />
    <add key="MandrillTemplate_CoacheeBookingReminder_Primary" value="book-your-next-coaching-session-primary" />
    <add key="MandrillTemplate_CoacheeBookingReminder_Secondary" value="book-your-next-coaching-session-secondary" />
    <add key="MandrillTemplate_Welcome" value="welcome-email" />
    <add key="MandrillTemplate_MeetYourCoach" value="meet-your-coach-testing" />
    <add key="MandrillTemplate_MeetYourCoach_Subject" value="Meet Your Coach, *|CoachFullName|*" />
    <add key="MandrillTemplate_Nudge" value="nudge-email" />
    <add key="MandrillTemplate_Module" value="module-email" />
    <add key="MandrillTemplate_SurveyInvitation" value="survey-invitation" />
    <add key="Email_Welcome_From_Name" value="Coordination @ Able, by Integral" />
    <add key="Email_Welcome_From_Address" value="coordination@integral.global" />
    <add key="Email_Welcome_SurveyOpenDays" value="21" />
    <add key="IntegralOrgId" value="1" />
    <!-- Record Id of the "Integral" Organisation in the db. Must be the same for all installs - dev and live. -->
    <add key="AbleOrgId" value="10" />
    <!-- Record Id of the "Able" Organisation in the db. Must be the same for all installs - dev and live. -->
    <add key="TestBounceRecipientEmail" value="testbounce@integral.global" />
    <!-- A non-existent email, used to test email bounce handling. Not overridden by OverrideRecipientEmail. -->
    <add key="MinimumRatersFor360Report" value="3" />
    <!-- Reports only available when at least this number of raters have replied. -->
    <add key="InvitedRatersMinimumRequired" value="8" />
    <!-- Coachees must invite at least this number of raters. -->
    <add key="InvitedRatersMaximumSuggested" value="12" />
    <!-- Display-only suggested maximum to invite. Not currently used. -->
    <add key="AbleSurveyDefaultOpenDays_Self" value="5" />
    <add key="AbleSurveyDefaultOpenDays_Rater" value="11" />
    <!-- On prod this identifies test accounts: -->
    <add key="TestUserAccounts" value="webdevperth@gmail.com,andrew@integral.global" />
    <!--
    Email template settings. New template files can be added here if needed.
    All files should be in the /templates/ folder, which is not publicly accessible.
    For subject line strings, merge fields are:
    1. "[SurveyName]" - name of the survey the email is about.
    2. "[SelfName]" - for emails to raters, this is the name of the self person (i.e. the coachee).
    -->
    <add key="EmailMasterTemplateFile" value="templates/EmailMasterTemplate.html" />
    <add key="SurveyInviteEmailSignoffFile" value="templates/SurveyInviteEmailSignoff.html" />
    <add key="SurveyInviteEmailSubject_Self" value="[SurveyName], Survey Invitation" />
    <add key="SurveyInviteEmailTemplateFile_Self" value="templates/SurveyInviteEmailTemplate_Self.html" />
    <add key="SurveyInviteEmailSubject_Rater" value="[SurveyName], Survey Invitation on Behalf of [ParticipantName]" />
    <add key="SurveyInviteEmailTemplateFile_Rater" value="templates/SurveyInviteEmailTemplate_Rater.html" />
    <add key="AlbertEmailMasterTemplateFile" value="templates/AlbertEmailMasterTemplate.html" />
    <add key="AlbertEmailMasterFooterFile" value="templates/AlbertEmailMasterFooter.html" />
    <add key="AlbertSurveyInviteEmailSubject_Self" value="360˚ Feedback Survey Invitation" />
    <add key="AlbertSurveyInviteEmailSubject_Rater" value="Invitation to provide 360˚ feedback for [SelfName]" />
    <add key="AlbertSurveyInviteEmailSubject_PulseRater" value="Invitation to provide feedback for [SelfName]" />
    <add key="AlbertSurveyInviteEmailTemplateFile_Self" value="templates/AlbertSurveyInviteEmailTemplate_Self.html" />
    <add key="AlbertSurveyInviteEmailTemplateFile_Rater" value="templates/AlbertSurveyInviteEmailTemplate_Rater.html" />
    <add key="AlbertSurveyInviteEmailTemplateFile_PulseRater" value="templates/AlbertSurveyInviteEmailTemplate_PulseRater.html" />
    <add key="JarvisSurveyInviteEmailSubject_Self" value="360˚ Feedback Survey Invitation" />
    <add key="JarvisSurveyInviteEmailSubject_Rater" value="Invitation to provide 360˚ feedback for [SelfName]" />
    <add key="JarvisSurveyInviteEmailTemplateFile_Self" value="templates/JarvisSurveyInviteEmailTemplate_Self.html" />
    <add key="JarvisSurveyInviteEmailTemplateFile_Rater" value="templates/JarvisSurveyInviteEmailTemplate_Rater.html" />
  </appSettings>
  <system.web>
    <hostingEnvironment shutdownTimeout="90" shadowCopyBinAssemblies="true" />
    <!-- maxRequestLength is max file upload size (in KB). Must be same as ServerMaxUploadFileSizeMB above -->
    <httpRuntime fcnMode="Single" targetFramework="4.8" maxRequestLength="20480" executionTimeout="360" maxQueryStringLength="10000" />
    <!-- Note the app manages it's own cookie & db session table. -->
    <sessionState mode="InProc" cookieless="false" cookieSameSite="Strict" timeout="120" />
    <pages clientIDMode="Static" buffer="true" validateRequest="false" enableEventValidation="false" autoEventWireup="false" enableViewState="false" enableViewStateMac="false" controlRenderingCompatibilityVersion="4.0" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-AU" uiCulture="en-AU" />
    <!-- Below settings transformed in web.release.config for production. -->
    <compilation batch="true" numRecompilesBeforeAppRestart="100" debug="true" targetFramework="4.8" />
    <customErrors mode="Off" />
    <httpModules>
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
    </httpModules>
  </system.web>
  <system.webServer>
    <applicationInitialization doAppInitAfterRestart="true">
      <add initializationPage="/" />
    </applicationInitialization>
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="100000" />
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
    </staticContent>
    <modules>
      <!-- Streamline the pipeline, remove unneeded modules. -->
      <remove name="AnonymousIdentification" />
      <remove name="DefaultAuthentication" />
      <remove name="FileAuthorization" />
      <remove name="FormsAuthentication" />
      <remove name="PassportAuthentication" />
      <remove name="Profile" />
      <remove name="RoleManager" />
      <remove name="ServiceModel-4.0" />
      <remove name="UrlAuthorization" />
      <remove name="UrlMappingsModule" />
      <remove name="UrlRoutingModule-4.0" />
      <remove name="WindowsAuthentication" />
      <!-- Re-register third-party telemetry modules in correct order -->
      <remove name="TelemetryCorrelationHttpModule" />
      <remove name="ApplicationInsightsWebTracking" />
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" preCondition="managedHandler" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler" />
    </modules>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" responseMode="ExecuteURL" path="Error404.aspx" />
    </httpErrors>
    <rewrite>
      <rules>
        <!-- Redirect from albert.integralsurveys.com to app.helloable.co -->
        <rule name="Redirect to app.helloable.co" stopProcessing="false">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="albert\.integralsurveys\.com" ignoreCase="true" negate="false" />
            <add input="{HTTP_HOST}" pattern="integral-able-live\.azurewebsites\.net" ignoreCase="true" negate="false" />
          </conditions>
          <action type="Redirect" url="https://app.helloable.co/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Don't adjust common validation path -->
        <rule name="validation" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^\.well-known/.*$" />
          <action type="None" />
        </rule>
        <!-- Allows versioning of resource files without changing URLs. -->
        <rule name="CachedResourceVersioning" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^(.*)__v[0-9.]+\.(css|js|gif|jpg|png|ico)$" />
          <action type="Rewrite" url="{R:1}.{R:2}" appendQueryString="true" />
        </rule>
        <!-- Persistent Storage Handler -->
        <rule name="Uploads" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^uploads/(.*)$" ignoreCase="true" />
          <action type="Rewrite" url="tools/StorageHandler.ashx" appendQueryString="false" />
        </rule>
        <!-- This may be where reports are run from. No reports yet. -->
        <rule name="ReportLinks" patternSyntax="ECMAScript" stopProcessing="true">
          <!-- example: ParticipantReport/LMP/r0QH0mIznMPIHfOSpc/deIVGWljGtF1BHgNKWp -->
          <match url="^ParticipantReport/([a-z-]+)/([a-z0-9]+)/([a-z0-9]+)$" />
          <action type="Rewrite" url="reports/{R:1}/default.aspx?svid={R:2}&amp;partid={R:3}" appendQueryString="false" />
        </rule>
        <!-- General 404 -->
        <rule name="Any invalid path show basic 404 page" stopProcessing="true">
          <match url="[!()$]" />
          <!-- [/._!()$] -->
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="pages/404Basic.aspx" appendQueryString="true" />
        </rule>
        <!-- Redirect to HTTPS unless we're on localhost -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern=".*test\..*" ignoreCase="true" negate="true" />
            <add input="{HTTP_HOST}" pattern="^local.*" ignoreCase="true" negate="true" />
            <add input="{HTTP_HOST}" pattern="^192\.168\..*" ignoreCase="true" negate="true" />
            <add input="{HTTPS}" pattern="^off$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Misc page redirects due to name changes. -->
        <rule name="redirect1" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^QuoteQwilrIframe$" />
          <action type="Redirect" url="QuoteQwilrView" appendQueryString="true" />
        </rule>
        <!-- Able API endpoints are in the /api/ folder. Rewrite to ".aspx" -->
        <rule name="api_endpoints" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^api/([a-z0-9_-]+)((?:/[a-z0-9_-]+))*/?$" />
          <action type="Rewrite" url="api/{R:1}.aspx" appendQueryString="true" />
        </rule>
        <rule name="partials" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^partials/([a-z0-9_-]+(?:/[a-z0-9_-]+)*)/?$" />
          <action type="Rewrite" url="/Partials/{R:1}.aspx" appendQueryString="true" />
        </rule>
        <!-- Pages with paths are translated to underscores in the /pages/ folder. -->
        <rule name="pages_with_path" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^([^\.\/]+)\/([^\.\/]+)\/*$" />
          <action type="Rewrite" url="/Pages/{R:1}_{R:2}.aspx" appendQueryString="true" />
        </rule>
        <rule name="ASHX handlers for json-only responses." stopProcessing="true">
          <match url="^([a-z0-9_-]+(?:/[a-z0-9_-]+)*)/?$" />
          <conditions logicalGrouping="MatchAll">
            <!-- Accept header must be ONLY application/json or text/plain -->
            <add input="{HTTP_ACCEPT}" pattern="^\s*(application/json|text/plain)\s*(;\s*q=[0-9.]+)?\s*$" />
            <!-- Corresponding .ashx file must exist -->
            <add input="{APPL_PHYSICAL_PATH}Pages\{R:1}.ashx" matchType="IsFile" />
          </conditions>
          <!-- Rewrite to the .ashx -->
          <action type="Rewrite" url="/Pages/{R:1}.ashx" appendQueryString="true" />
        </rule>
        <!-- For Able, all pages are run from the /pages/ folder. -->
        <!-- Exception - for certain pages, ignore extra paths in url -->
        <rule name="pages_nopath" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^([a-z0-9_-]+)((?:/[a-z0-9_-]+))*/?$" />
          <action type="Rewrite" url="/Pages/{R:1}.aspx" appendQueryString="true" />
        </rule>
        <rule name="pages" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^([a-z0-9_-]+(?:/[a-z0-9_-]+)*)/?$" />
          <action type="Rewrite" url="/Pages/{R:1}.aspx" appendQueryString="true" />
        </rule>
        <!-- Return 404 for certain internal-only paths. -->
        <rule name="notfound" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="templates|appcode|bin|docs|MasterPages|obj|Pages|Partials|Properties|UserControls" />
          <action type="CustomResponse" statusCode="404" statusDescription="Not Found" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Forcing Download for zip" preCondition="FileIsZIP">
          <match serverVariable="RESPONSE_Content-Disposition" pattern=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" pattern="(.*)\\([^/]+)\.zip" />
          </conditions>
          <action type="Rewrite" value="attachment; filename={C:2}.zip" />
        </rule>
        <preConditions>
          <preCondition name="FileIsZIP">
            <add input="{REQUEST_FILENAME}" pattern="\.zip" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <defaultDocument enabled="true">
      <files>
        <remove value="default.aspx" />
        <remove value="default.asp" />
        <remove value="index.htm" />
        <remove value="index.html" />
        <remove value="default.htm" />
        <remove value="iisstart.htm" />
        <add value="default.aspx" />
      </files>
    </defaultDocument>
    <!-- rewrite trace to test 404 page - ->
    <tracing>
      <traceFailedRequests>
        <add path="*">
          <traceAreas>
            <add provider="WWW Server" areas="Rewrite" verbosity="Verbose" />
          </traceAreas>
          <failureDefinitions timeTaken="00:00:00" statusCodes="200-500" />
        </add>
      </traceFailedRequests>
    </tracing>
    -->
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
  <!-- Enable this if cache invalidates too often.
  <system.runtime.caching>
    <memoryCache>
      <namedCaches>
        <add name="default" physicalMemoryLimitPercentage="5" />
      </namedCaches>
    </memoryCache>
  </system.runtime.caching>
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="RestSharp" publicKeyToken="598062e77f915f75" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-106.15.0.0" newVersion="106.15.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encoding.CodePages" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.10" newVersion="9.0.0.10" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <!-- System.ValueTuple v4.0.0.0 ships with .NET Framework 4.7+ in the GAC (as a type-forwarder
             to mscorlib). NuGet's targets deliberately suppress copying the package lib (v4.0.5.0) to
             bin\ on net47+, so the GAC version is the only one loadable at runtime. Downgrade redirect:
             requests for any version up to 4.0.5.0 resolve to the GAC's 4.0.0.0 forwarder, which routes
             the actual type calls into mscorlib. Safe because no real implementation lives in this DLL. -->
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.7" newVersion="10.0.0.7" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.7" newVersion="10.0.0.7" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.7" newVersion="10.0.0.7" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.3" newVersion="10.0.0.3" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.10" newVersion="9.0.0.10" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
