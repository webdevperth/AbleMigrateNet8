<script>

  var CtlOrgRpt_TopFilters = {

    selBenchmark: null,
    benchType: "",
    orgLevelTagId: "#ctlOrgRpt_TopFilters_OrgLevel",
    demographicTagId: "#ctlOrgRpt_TopFilters_Demographic",
    benchTypeTagId: "#ctlOrgRpt_TopFilters_BenchType",
    categoryTagId: "#ctlOrgRpt_TopFilters_Category",
    demographicTagId: "#ctlOrgRpt_TopFilters_Demographic",

    Init: function () { // called by docready below.

      var _this = this;
      // this.selBenchmark = $("#ctlOrgRpt_TopFilters_BenchType");
      // this.benchType = Cookies.get('OrgRpt_BenchType');
      // this.SetBenchSelector();

      app_CommonFunctions.BootMultiSelect(
        $(_this.orgLevelTagId + "," + _this.benchTypeTagId + "," + _this.categoryTagId + "," + _this.demographicTagId),
        {
          initialVals: null,
          onDropdownShown: function (event) {
            this.options.initialVals = _this.GetStringListFromVal(this.$select.val());
          },
          onDropdownHidden: function (event) {
            var newVals = _this.GetStringListFromVal(this.$select.val());
            if (this.options.initialVals != newVals)
              _this.FilterChanged(
                _this.GetStringListFromVal($(_this.orgLevelTagId).val()),
                _this.GetStringListFromVal($(_this.benchTypeTagId).val()),
                _this.GetStringListFromVal($(_this.categoryTagId).val())
              );
          },
          onSelectAll: function () {
            this.clearSelection();
          }
        }
      );

      _this.Loaded(_this.GetSelectedBenchType(), _this.GetSelectedOrgLevels(), _this.GetSelectedCategory());

    }, // init

    GetSelectedOrgLevels: function () {
      return this.GetStringListFromVal($(this.orgLevelTagId).val());
    },

    GetSelectedDemographics: function () {
      return this.GetStringListFromVal($(this.demographicTagId).val());
    },

    GetSelectedCategory: function () {
      return $(this.categoryTagId).val();
    },

    GetSelectedBenchType: function () {
      return $(this.benchTypeTagId).val();
    },

    GetStringListFromVal: function (val) {
      if (val == null) return ""; // no selection
      if (val.join) return val.join(","); // multiple selection
      return val; // single selection
    },

    SetBenchSelector: function (bench) {
      var benchOption = this.selBenchmark.find("option[value=" + this.benchType + "]");
      if (benchOption.length == 0) this.ChangedBenchSelector();
    },

    ChangedBenchSelector: function () {
      this.benchType = this.selBenchmark.val();
      //Cookies.set('OrgRpt_BenchType', this.benchType, { expires: 3600 });
      this.FilterChanged(this.benchType); // caller overrides
    },

    // Events. Caller replaces these.
    Loaded: function (orgLevelVals, benchTypeVal, categoryVal) { },
    FilterChanged: function (orgLevelVals, benchTypeVal, categoryVal) { }

  };

  $(document).ready(function () {

    CtlOrgRpt_TopFilters.Init();

  });


</script>
